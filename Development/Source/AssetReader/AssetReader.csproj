<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>PMM.AssetReader</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="'$(BundledReferenceDir)' == ''">
    <PackageReference Include="UAssetAPI" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundledReferenceDir)' != ''">
    <Reference Include="UAssetAPI"><HintPath>$(BundledReferenceDir)/UAssetAPI.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(BundledReferenceDir)/Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="ZstdSharp"><HintPath>$(BundledReferenceDir)/ZstdSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
