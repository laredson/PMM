+
+// monitorStartupSplash reads only the session created by this Host. It does not
+// run processes, repair dependencies or interpret state content as code.
+func (h *Host) monitorStartupSplash(splash *startupSplash, done <-chan struct{}) {
+	ticker := time.NewTicker(100 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-done:
+			return
+		case <-splash.done:
+			return
+		case <-ticker.C:
+			f, err := os.Open(h.StateFile)
+			if err != nil {
+				continue
+			}
+			b, err := io.ReadAll(io.LimitReader(f, 65537))
+			f.Close()
+			if err == nil && len(b) <= 65536 {
+				splash.Update(string(b))
+			}
+		}
+	}
