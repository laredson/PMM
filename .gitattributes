# PMM repository line-ending and binary handling
* text=auto

*.cs       text eol=lf
*.csproj   text eol=lf
*.props    text eol=lf
*.targets  text eol=lf
*.xaml     text eol=lf
*.xml      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

*.ps1      text eol=crlf
*.psm1     text eol=crlf
*.psd1     text eol=crlf
*.cmd      text eol=crlf
*.bat      text eol=crlf
*.sln      text eol=crlf

*.txt      text eol=lf
*.ini      text eol=lf

*.exe      binary
*.dll      binary
*.pdb      binary
*.pak      binary
*.zip      binary
*.7z       binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
