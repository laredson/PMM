# Preserve the exact bytes of the validated release tree.
# PMM verifies its packaged application against SHA256SUMS.txt; automatic EOL
# normalization can otherwise change valid PowerShell/XAML/JSON files at
# checkout and make the repository fail its own integrity check.
* -text

*.exe      binary
*.dll      binary
*.pdb      binary
*.pak      binary
*.zip      binary
*.7z       binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
