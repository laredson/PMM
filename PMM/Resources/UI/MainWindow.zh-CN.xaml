<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PMM - Palworld Manager Merger v1.3.1"
        Width="1460" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" ShowActivated="True"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI"
        FontSize="13">
  <!--
    v1.1.1 UI: the merge engine remains conservative; the contained-superset path returns a proven real cooked provider unchanged.
    The workspace is intentionally resizable and explains the Analyze plan
    asset-by-asset instead of presenting only one summary line.
  -->
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#EAF0F7"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#F8FBFF"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardAltBackground" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#D5DAE0"/>
    <SolidColorBrush x:Key="InputBorder" Color="#C5CBD2"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#17202A"/>
    <SolidColorBrush x:Key="MutedText" Color="#5F6B76"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#DDEBFF"/>
    <SolidColorBrush x:Key="SelectionText" Color="#152238"/>
    <SolidColorBrush x:Key="GridLine" Color="#E6E9ED"/>
    <SolidColorBrush x:Key="Splitter" Color="#DDE2E8"/>
    <SolidColorBrush x:Key="StatusBackground" Color="#E9EDF2"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#2E9D50"/>
    <SolidColorBrush x:Key="SoftBlue" Color="#EEF4FF"/>
    <SolidColorBrush x:Key="SoftGreen" Color="#ECF8EF"/>
    <SolidColorBrush x:Key="SoftAmber" Color="#FFF7E6"/>
    <SolidColorBrush x:Key="SoftRed" Color="#FFF0F0"/>
    <SolidColorBrush x:Key="SoftGray" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="FixHeaderBackground" Color="#EEF3F8"/>
    <SolidColorBrush x:Key="FixHeaderBorder" Color="#C9D5E2"/>
    <SolidColorBrush x:Key="NoticeBackground" Color="#FFF7ED"/>
    <SolidColorBrush x:Key="NoticeBorder" Color="#F2B56B"/>
    <SolidColorBrush x:Key="SourceBackground" Color="#F4F8FF"/>
    <SolidColorBrush x:Key="SourceBorder" Color="#CAD8EA"/>
    <SolidColorBrush x:Key="ConfigureBackground" Color="#FFF9EE"/>
    <SolidColorBrush x:Key="ConfigureBorder" Color="#E8D6AE"/>
    <SolidColorBrush x:Key="BuildBackground" Color="#F7F5FF"/>
    <SolidColorBrush x:Key="BuildBorder" Color="#D8D1EF"/>
    <SolidColorBrush x:Key="OutputBackground" Color="#F1FAF3"/>
    <SolidColorBrush x:Key="OutputBorder" Color="#C8E2CE"/>
    <SolidColorBrush x:Key="BackupBackground" Color="#FAF8F5"/>
    <SolidColorBrush x:Key="BackupBorder" Color="#DDD7CF"/>
    <SolidColorBrush x:Key="AdvancedBackground" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="AccentHeadingBlue" Color="#284B73"/>
    <SolidColorBrush x:Key="AccentHeadingAmber" Color="#7A551A"/>
    <SolidColorBrush x:Key="AccentHeadingPurple" Color="#51427C"/>
    <SolidColorBrush x:Key="AccentHeadingGreen" Color="#2F6B3B"/>
    <SolidColorBrush x:Key="WarmHeading" Color="#62584C"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#111827"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#CBD5E1"/>

    <Style x:Key="DefaultButton" TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}"/>

    <Style x:Key="ImportButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#7C3AED"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#6D28D9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#6D28D9"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#1D4ED8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BuildButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#D97706"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#B45309"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B45309"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DeployButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#2E9D50"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#258342"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#258342"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#0F9D8A"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0F766E"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0F766E"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AutoRunButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="18,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid ClipToBounds="True" SnapsToDevicePixels="True">
              <Border Name="AutoRunBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
              <Canvas Name="SparkleLayer" IsHitTestVisible="False" Opacity="0.9" Panel.ZIndex="1">
                <TextBlock Name="AutoSparkle1" Text="✦" Foreground="{DynamicResource AccentBlue}" FontSize="12" Opacity="0" Canvas.Top="2"><TextBlock.RenderTransform><TranslateTransform x:Name="SparkleMove1" X="-30"/></TextBlock.RenderTransform></TextBlock>
                <TextBlock Name="AutoSparkle2" Text="✧" Foreground="{DynamicResource AccentBlue}" FontSize="10" Opacity="0" Canvas.Top="13"><TextBlock.RenderTransform><TranslateTransform x:Name="SparkleMove2" X="-30"/></TextBlock.RenderTransform></TextBlock>
                <TextBlock Name="AutoSparkle3" Text="✦" Foreground="{DynamicResource AccentBlue}" FontSize="8" Opacity="0" Canvas.Top="7"><TextBlock.RenderTransform><TranslateTransform x:Name="SparkleMove3" X="-30"/></TextBlock.RenderTransform></TextBlock>
              </Canvas>
              <ContentPresenter Panel.ZIndex="2" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AutoRunBorder" Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SparkleLayer" Property="Visibility" Value="Collapsed"/><Setter Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="Tag" Value="Running"><Setter TargetName="SparkleLayer" Property="Visibility" Value="Collapsed"/></Trigger>
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SparkleMove1" Storyboard.TargetProperty="X" From="-30" To="420" Duration="0:0:6" RepeatBehavior="Forever"/>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AutoSparkle1" Storyboard.TargetProperty="Opacity" Duration="0:0:6" RepeatBehavior="Forever">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/><SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0.9"/><SplineDoubleKeyFrame KeyTime="0:0:2.25" Value="0.8"/><SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:6" Value="0"/>
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetName="SparkleMove2" Storyboard.TargetProperty="X" From="-30" To="420" BeginTime="0:0:2" Duration="0:0:6" RepeatBehavior="Forever"/>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AutoSparkle2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:2" Duration="0:0:6" RepeatBehavior="Forever">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0"/><SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.8"/><SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="0.75"/><SplineDoubleKeyFrame KeyTime="0:0:2.35" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:6" Value="0"/>
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetName="SparkleMove3" Storyboard.TargetProperty="X" From="-30" To="420" BeginTime="0:0:4" Duration="0:0:6" RepeatBehavior="Forever"/>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AutoSparkle3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:4" Duration="0:0:6" RepeatBehavior="Forever">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0"/><SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.75"/><SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="0.7"/><SplineDoubleKeyFrame KeyTime="0:0:2.45" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:6" Value="0"/>
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0" Margin="7,2,3,2" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                  <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="360">
                  <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PriorityEditorTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Margin" Value="3,1"/>
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="MaxLength" Value="18"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Margin="0,0,2,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderBrush" Value="{DynamicResource GridLine}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Background" Value="{DynamicResource CardBorder}"/>
    </Style>
    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource Splitter}"/>
      <Setter Property="ShowsPreview" Value="True"/>
    </Style>
    <Style x:Key="SummaryCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10">
      <Grid x:Name="GrdHeaderLayout">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="4,0,22,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image x:Name="ImgPMMLogo" Grid.Column="0" Width="148" Height="148" Stretch="Uniform" Margin="0,0,20,0" SnapsToDevicePixels="True"/>
          <StackPanel x:Name="PnlHeaderTitle" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="PALWORLD" FontFamily="Bahnschrift SemiBold" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" LineHeight="33"/>
            <TextBlock Text="MANAGER" FontFamily="Bahnschrift SemiBold" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" LineHeight="33"/>
            <TextBlock Text="MERGER" FontFamily="Bahnschrift SemiBold" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" LineHeight="33"/>
            <TextBlock Text="Palworld 模组管理器与兼容性合并工具" Foreground="{DynamicResource MutedText}" FontSize="14" Margin="1,5,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="GrdHeaderActions" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Button x:Name="BtnDetectGame" Grid.Row="0" HorizontalAlignment="Stretch" MinWidth="0" Padding="12,7" Margin="0,0,0,6" ToolTip="自动检测 Palworld。如果自动检测失败，PMM 会要求你选择 Steam 或 Palworld 文件夹。">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}">
                <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                <Setter Property="Opacity" Value="1"/>
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="1"/></Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel>
              <TextBlock x:Name="TxtGamePathStatus" Text="未检测到 Palworld - 点击检测" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="自动检测，或在设置中配置安装位置。" Foreground="{DynamicResource MutedText}" FontSize="11.5" TextAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
          </Button>
          <Border Grid.Row="2" Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" Padding="8,4">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <WrapPanel Grid.Column="0" VerticalAlignment="Center"><CheckBox x:Name="TglAutoMode" Content="半自动" VerticalAlignment="Center" Margin="2,0,12,0" ToolTip="启用后，你手动启动的工作流操作会自动继续执行所有剩余的安全步骤。"/><CheckBox x:Name="ChkAutoPlay" Content="部署后运行 Palworld" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="自动运行最终成功部署后启动 Palworld。"/></WrapPanel>
              <Button Grid.Column="1" x:Name="BtnAutoRun" Content="AUTO" Style="{StaticResource AutoRunButton}" Tag="Idle" HorizontalAlignment="Stretch" MinWidth="150" FontWeight="Bold" Margin="10,3,6,3" ToolTip="从当前状态一次执行所有剩余安全步骤，无需启用半自动。"/>
              <Button Grid.Column="2" x:Name="BtnCancelOperation" Content="取消" MinWidth="92" IsEnabled="False" ToolTip="取消当前操作或自动工作流。如果部署已开始提交，则会回滚。"/>
            </Grid>
          </Border>
          <UniformGrid Grid.Row="1" Columns="3" HorizontalAlignment="Stretch" Margin="0,0,0,6"><Button x:Name="BtnOpenGame" Content="打开游戏文件夹"/><Button x:Name="BtnOpenModsFolder" Content="打开模组文件夹"/><Button x:Name="BtnPlay" Content="启动 Palworld" Padding="16,6"/></UniformGrid>
        </Grid>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,10,0,8" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource PrimaryText}">
      <TabItem Header="模组与合并" x:Name="TabMerge">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColLibrary" Width="2*" MinWidth="290" MaxWidth="520"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition x:Name="ColAnalysisWorkspace" Width="3*" MinWidth="460"/>
          </Grid.ColumnDefinitions>

          <!-- Source library. PMM patches are deliberately rendered separately below. -->
          <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="6"/>
                <RowDefinition x:Name="RowPatches" Height="180" MinHeight="110" MaxHeight="520"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="模组库" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock x:Name="TxtLibraryCount" Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                  <Button x:Name="BtnImport" Content="导入..." ToolTip="选择一个或多个 PAK/ZIP/7Z/RAR 文件，或从文件夹导入所有兼容模组"/>
                  <Button x:Name="BtnImportGameMods" Content="导入 ~mods" ToolTip="将游戏当前的 PAK 复制到 PMM 库"/>
                  <Button x:Name="BtnScan" Content="分析" Padding="16,5"/>
                </WrapPanel>
              </Grid>

              <Grid Grid.Row="1" Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TxtModFilter" ToolTip="按名称或状态筛选源模组"/>
                <TextBlock Grid.Column="1" Text="筛选" VerticalAlignment="Center" Margin="8,0,2,0" Foreground="{DynamicResource MutedText}"/>
              </Grid>

              <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DataGrid x:Name="LstMods" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" AlternationCount="2" AllowDrop="True" HorizontalGridLinesBrush="{DynamicResource GridLine}" ToolTip="Ctrl/Shift select multiple mods; Ctrl+A selects all. Merge order: drag a row, or type a new number in Order. Top applies earlier; bottom has higher priority.">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                    <Style.Triggers>
                      <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource CardAltBackground}"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
                      <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value="0.58"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="启用" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Enabled source mods participate in Analyze, Build and Deploy"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="顺序" Width="66" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Priority, Mode=OneWay}" Tag="{Binding Name}" Style="{StaticResource PriorityEditorTextBox}" ToolTip="Type a new merge position. Values below 1 become 1; values above the library size become the last position."/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="模组" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="MB" Binding="{Binding SizeText}" Width="72" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Hash" Binding="{Binding HashShort}" Width="105" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>

              <StackPanel Grid.Row="1" Margin="0,7,0,0">
                <WrapPanel HorizontalAlignment="Center">
                  <Button x:Name="BtnSelectAllMods" Content="全选" IsEnabled="False"/>
                  <Button x:Name="BtnClearModSelection" Content="清除选择" IsEnabled="False"/>
                  <Button x:Name="BtnEnableMods" Content="启用所选" IsEnabled="False"/>
                  <Button x:Name="BtnDisableMods" Content="禁用所选" IsEnabled="False"/>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                  <Button x:Name="BtnPriorityUp" Content="提前 / 降低优先级" IsEnabled="False" ToolTip="Move this mod upward: its diff is applied earlier"/>
                  <Button x:Name="BtnPriorityDown" Content="延后 / 提高优先级" IsEnabled="False" ToolTip="Move this mod downward: it wins truly overlapping values"/>
                  <Button x:Name="BtnDeleteMod" Content="删除所选" IsEnabled="False"/>
                  <ComboBox x:Name="CmbLibraryOrder" Width="188" Margin="3" ToolTip="Reorder the imported mod library. Changing order invalidates Analyze."/>
                  <Button x:Name="BtnReorderLibrary" Content="重新排序" IsEnabled="True" ToolTip="Reorder the imported mod library. Changing order invalidates Analyze."/>
                </WrapPanel>
              </StackPanel>


              </Grid>

              <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

              <Border Grid.Row="4" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource CardAltBackground}" Padding="6">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="1,0,1,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="兼容性补丁" FontWeight="SemiBold"/>
                      <TextBlock x:Name="TxtPatchCount" Foreground="{DynamicResource MutedText}" FontSize="11.5"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                      <Button x:Name="BtnValidatePatch" Content="验证合并" Padding="8,3" MinHeight="26" IsEnabled="False" ToolTip="Mark the selected saved merge as tested and functional in runtime."/>
                      <Button x:Name="BtnDeletePatch" Content="删除合并" Padding="8,3" MinHeight="26" IsEnabled="False" ToolTip="Delete the exact deployed copy if present and every matching saved copy inside PMM."/>
                    </WrapPanel>
                  </Grid>
                  <TextBlock Grid.Row="1" Margin="2,0,2,4" FontSize="10.5" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Text="Choose a saved overlay, or No compatibility patch to deploy source mods only. A deployed external PMM merge can still be inspected/undeployed/deleted even when it is not selectable for Deploy; only exact source hashes + mappings make a build reusable."/>
                  <DataGrid x:Name="LstPatches" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" FontSize="11" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="使用" Width="42">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><RadioButton GroupName="PMMPatchSelection" IsChecked="{Binding Selected, Mode=OneWay}" IsEnabled="{Binding Selectable}" Tag="{Binding SelectionKey}" ToolTip="{Binding SelectTip}" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="补丁" Binding="{Binding Name}" Width="*" MinWidth="135" IsReadOnly="True"/>
                      <DataGridTextColumn Header="决策" Binding="{Binding DecisionSummary}" Width="130" IsReadOnly="True"/>
                      <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="150" IsReadOnly="True"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>

            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

          <!-- Analysis is the dominant workspace. Conflict and unsupported sections collapse when unused. -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="RowAnalysisWorkspace" Height="*"/>
              <RowDefinition x:Name="RowAnalysisConflictSplitter" Height="0"/>
              <RowDefinition x:Name="RowResolutionWorkspace" Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition x:Name="RowWorkspaceFiller" Height="0"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Expander x:Name="ExpAnalysis" Grid.Row="0" Header="分析计划" IsExpanded="True" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtAnalysisHeadline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="3,0,3,5"/>
                <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,5">
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftBlue}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtSharedCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="共享资源" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftGreen}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtAutoCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="自动合并" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftAmber}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtDecisionCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="决策" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftRed}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtUnsupportedCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="不支持" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource BuildBackground}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtExperimentalCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="实验性" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtIdenticalCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="相同" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                </UniformGrid>

                <TextBlock x:Name="TxtAnalysisScope" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="3,0,3,6"/>
                <StackPanel Grid.Row="3" Margin="3,0,3,5">
                  <TextBlock x:Name="TxtAnalyzeProgress" Text="" Foreground="{DynamicResource MutedText}"/>
                  <ProgressBar x:Name="PrgAnalyze" Height="10" Margin="0,3,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50"/>
                </StackPanel>

                <DataGrid x:Name="DgAnalysisAssets" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowDetailsVisibilityMode="VisibleWhenSelected" EnableRowVirtualization="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="125"/>
                    <DataGridTextColumn Header="资源" Binding="{Binding Asset}" Width="1.25*"/>
                    <DataGridTextColumn Header="适配器" Binding="{Binding Adapter}" Width="145"/>
                    <DataGridTextColumn Header="涉及的模组" Binding="{Binding Providers}" Width="1.7*"/>
                    <DataGridTextColumn Header="更改" Binding="{Binding Changes}" Width="105"/>
                  </DataGrid.Columns>
                  <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,1" Padding="10,7">
                        <StackPanel>
                          <TextBlock Text="{Binding FullAsset}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Details}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </DataGrid.RowDetailsTemplate>
                </DataGrid>
              </Grid>
            </Expander>

            <GridSplitter x:Name="SplAnalysisResolution" Grid.Row="1" Height="6" Margin="0,3,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Visibility="Collapsed"/>

            <Expander x:Name="ExpConflicts" Grid.Row="2" Margin="0,6,0,0" IsExpanded="False" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="6">
              <Expander.Header><TextBlock x:Name="TxtConflictHeader" Text="解决与审查 (0)" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/></Expander.Header>
              <Grid MinHeight="175" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="ColConflictAssets" Width="250" MinWidth="175"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*" MinWidth="360"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="LstConflictAssets" Grid.Column="0" DisplayMemberPath="Display"/>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
                <Grid Grid.Column="2" Margin="8,0,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock x:Name="TxtConflictMods" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="TxtConflictAsset" Grid.Row="1" Margin="0,3,0,7" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                  <WrapPanel Grid.Row="2" Margin="0,0,0,7" VerticalAlignment="Center">
                    <TextBlock Text="全部应用：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbBulkWinner" Width="190" Margin="0,0,6,0"/>
                    <TextBlock Text="自定义：" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <TextBox x:Name="TxtBulkCustom" Width="110" Margin="0,0,6,0" ToolTip="Used only when Custom is selected"/>
                    <Button x:Name="BtnApplyBulk" Content="应用到所有行"/>
                    <Button x:Name="BtnOpenReview" Content="打开审查文件"/>
                  </WrapPanel>
                  <DataGrid x:Name="DgDecisions" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="CellOrRowHeader" IsReadOnly="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
                </Grid>
              </Grid>
            </Expander>

            <Expander x:Name="ExpUnsupported" Grid.Row="3" Header="已阻止的共享资源 (0)" Margin="0,6,0,0" IsExpanded="False" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="6">
              <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="LstUnsupportedAssets" Grid.Row="0" MaxHeight="86" DisplayMemberPath="Display"/>
                <TextBox x:Name="TxtUnsupported" Grid.Row="1" Margin="0,5,0,5" MaxHeight="90" MinHeight="42" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardAltBackground}"/>
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="禁用来源：" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <ComboBox x:Name="CmbUnsupportedDisable" Grid.Column="1" Margin="0,0,7,0"/>
                  <Button x:Name="BtnDisableUnsupported" Grid.Column="2" Content="禁用所选模组并分析" Style="{StaticResource PrimaryButton}" Padding="10,4"/>
                  <TextBlock x:Name="TxtUnsupportedHint" Grid.Column="3" Text="When an asset is unsupported, PMM can suggest the source whose removal disturbs the fewest other compatible shared merges. This is a structural suggestion, not a gameplay judgement." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Margin="10,0,0,0"/>
                </Grid>
                <WrapPanel Grid.Row="3" Margin="0,5,0,0">
                  <Button x:Name="BtnOpenAIHandoff" Content="打开案例" IsEnabled="False" ToolTip="Open the selected asset case. Choose ZIP, MCP or a client inside the case."/>
                  <Button x:Name="BtnImportManualSolution" Content="导入 AI/手动解决方案..." IsEnabled="False" ToolTip="Import PMM_MANUAL_SOLUTION_V1. PMM validates structure/provenance, but it remains experimental until tested in game."/>
                </WrapPanel>
              </Grid>
            </Expander>

            <Border Grid.Row="5" Margin="0,6,0,0" Padding="8" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="2,0,2,3">
                  <TextBlock Text="构建与部署：" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <CheckBox x:Name="ChkCloseGame" Content="部署前关闭 Palworld" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  <CheckBox x:Name="ChkForceClose" Content="正常关闭超时则强制关闭" VerticalAlignment="Center" Margin="0,0,18,0"/>
                </WrapPanel>
                <TextBlock x:Name="TxtBuildDeployHint" Grid.Row="1" Margin="3,0,3,4" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                <UniformGrid Grid.Row="2" Rows="1" Columns="3">
                  <Button x:Name="BtnBuild" Content="构建合并" FontWeight="Bold"/>
                  <Button x:Name="BtnDeploy" Content="部署"/>
                  <Button x:Name="BtnUndeployPatch" Content="取消部署" IsEnabled="False" ToolTip="Remove only the selected merge from Palworld ~mods. The saved PMM build is kept."/>
                </UniformGrid>
                <StackPanel Grid.Row="3" Margin="3,5,3,0">
                  <TextBlock x:Name="TxtOperationProgress" Text="就绪。上次操作将保留在这里。" HorizontalAlignment="Center" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="PrgOperation" Height="10" Margin="40,3,40,0" Minimum="0" Maximum="100" Value="0" Visibility="Visible" Foreground="#64748B"/>
                  <TextBlock x:Name="TxtBuildProgress" Text="" Visibility="Collapsed"/>
                  <ProgressBar x:Name="PrgBuild" Height="1" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="TabFixLab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="修复实验室" VerticalAlignment="Center"/>
            <Border x:Name="BrdFixLabBadge" Background="#D97706" CornerRadius="9" Margin="6,0,0,0" Padding="6,1" Visibility="Collapsed">
              <TextBlock x:Name="TxtFixLabBadge" Text="1" Foreground="White" FontWeight="Bold" FontSize="11"/>
            </Border>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" CanContentScroll="True">
          <Grid Margin="10" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Compact Fix Lab header + Game Reference controls. -->
            <Border Grid.Row="0" Background="{DynamicResource FixHeaderBackground}" BorderBrush="{DynamicResource FixHeaderBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="修复实验室" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource FixHeaderBorder}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="本地配方引擎" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="使用源 PAK、当前游戏文件和紧凑的可复现配方，在本地修复受支持的旧版模组。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,2,0,0"/>
                  <TextBlock x:Name="TxtFixLabGameReference" Text="当前游戏参考" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" Margin="0,5,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="TxtFixLabGameReferenceProgress" Foreground="{DynamicResource MutedText}" Visibility="Collapsed" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PrgFixLabGameReference" Width="180" Height="7" Margin="8,0,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <Button x:Name="BtnFixLabRefreshDashboard" Content="刷新修复实验室" MinWidth="180" ToolTip="Refresh the Fix Lab dashboard on demand. Tab switching uses the cached view so navigation stays immediate."/>
                  <Button x:Name="BtnFixLabBuildReference" Content="构建 / 刷新游戏参考" MinWidth="180"/>
                  <Button x:Name="BtnFixLabOpenReference" Content="打开参考" MinWidth="180" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Notice does not consume a permanent grid slot. -->
            <Border x:Name="BrdFixLabNotice" Grid.Row="1" Background="{DynamicResource NoticeBackground}" BorderBrush="{DynamicResource NoticeBorder}" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center" Margin="1,0,8,0"/>
                <TextBlock x:Name="TxtFixLabNotice" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingAmber}"/>
                <Button x:Name="BtnFixLabDismissNotice" Grid.Column="2" Content="X" ToolTip="关闭" Margin="10,0,0,0" Padding="9,2"/>
              </Grid>
            </Border>

            <!-- Six responsive work cards: 2 columns x 3 rows. No minimum widths. -->
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

              <Expander x:Name="ExpFixLabSource" Grid.Row="0" Grid.Column="0" IsExpanded="True" Background="{DynamicResource SourceBackground}" BorderBrush="{DynamicResource SourceBorder}" BorderThickness="1" Padding="9" Margin="0,0,4,8">
                <Expander.Header>
                  <StackPanel Margin="0,1">
                    <TextBlock Text="1. 可修复来源" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingBlue}"/>
                    <TextBlock x:Name="TxtFixLabCandidateCount" Text="0 个候选" Foreground="{DynamicResource MutedText}" FontSize="11"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,0">
                  <DockPanel LastChildFill="True">
                    <Button x:Name="BtnFixLabDiscover" DockPanel.Dock="Right" Content="分析可修复模组" Margin="8,0,0,5" Padding="10,4"/>
                    <Button x:Name="BtnFixLabIgnoreSource" DockPanel.Dock="Right" Content="忽略此旧版模组" Margin="8,0,0,5" Padding="10,4" ToolTip="Skip Fix Lab for this exact source hash and allow Analyze/AUTO to continue under your responsibility."/>
                    <Button x:Name="BtnFixLabDeleteSource" DockPanel.Dock="Right" Content="删除此模组" Margin="8,0,0,5" Padding="10,4" ToolTip="Delete the source mod from the PMM library and its exact matching PAK from ~mods using the same operation as Imported Mods > Delete."/>
                    <TextBlock Text="选择修复实验室要修复的旧版模组案例。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,3,0,5"/>
                  </DockPanel>
                  <ListBox x:Name="LstFixLabCandidates" SelectionMode="Single" SelectedValuePath="RecipeId" MinHeight="70" MaxHeight="130">
                    <ListBox.ItemTemplate><DataTemplate>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <RadioButton VerticalAlignment="Center" IsHitTestVisible="False" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceNames}" FontSize="11" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SourceCount}" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Margin="6,0,2,0"/>
                      </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="TxtFixLabCandidate" Margin="0,5,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Text="仅显示具有已记录修复配方的已导入模组。" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Expander>

              <Expander x:Name="ExpFixLabConfigure" Grid.Row="0" Grid.Column="1" IsExpanded="True" Background="{DynamicResource ConfigureBackground}" BorderBrush="{DynamicResource ConfigureBorder}" BorderThickness="1" Padding="9" Margin="4,0,0,8">
                <Expander.Header><StackPanel Margin="0,1"><TextBlock Text="2. 配置修复" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingAmber}"/><TextBlock Text="选择所需输出。PMM 不会替你选择外观或行为变体。" Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,6,0,0">
                  <TextBlock Text="输出变体" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <ComboBox x:Name="CmbFixLabVariant" DisplayMemberPath="Label" SelectedValuePath="Id" HorizontalAlignment="Stretch"/>
                  <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ConfigureBorder}" BorderThickness="1" CornerRadius="5" Padding="8"><StackPanel><TextBlock Text="配方摘要" FontWeight="SemiBold" Margin="0,0,0,3"/><TextBlock TextWrapping="Wrap"><Run Text="旧版来源："/><Run x:Name="TxtFixLabLegacySource" Text="-"/></TextBlock><TextBlock TextWrapping="Wrap"><Run Text="修复模块："/><Run x:Name="TxtFixLabModules" Text="-"/></TextBlock><TextBlock TextWrapping="Wrap"><Run Text="输出大小："/><Run x:Name="TxtFixLabOutputSize" Text="等待构建"/></TextBlock></StackPanel></Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ConfigureBorder}" BorderThickness="1" CornerRadius="5" Padding="8"><StackPanel><TextBlock Text="修复说明" FontWeight="SemiBold" Margin="0,0,0,3"/><TextBlock x:Name="TxtFixLabVariantDescription" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" MaxHeight="72"/></StackPanel></Border>
                  </Grid>
                </StackPanel>
              </Expander>

              <Expander x:Name="ExpFixLabBuild" Grid.Row="1" Grid.Column="0" IsExpanded="True" Background="{DynamicResource BuildBackground}" BorderBrush="{DynamicResource BuildBorder}" BorderThickness="1" Padding="9" Margin="0,0,4,8">
                <Expander.Header><StackPanel Margin="0,1"><TextBlock Text="3. 构建并验证" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingPurple}"/><TextBlock Text="在独立处理进程中运行。修复构建和验证期间仍可继续使用 PMM。" Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander.Header>
                <Grid Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel><TextBlock x:Name="TxtFixLabRepairState" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/><TextBlock x:Name="TxtFixLabResult" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" MaxHeight="58"/>
                    <TextBlock x:Name="TxtFixLabRepairProgress" Margin="0,7,0,2" TextWrapping="Wrap" Foreground="{DynamicResource AccentHeadingPurple}" Visibility="Collapsed"/>
                    <ProgressBar x:Name="PrgFixLabRepair" Height="9" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#6D5AA8"/></StackPanel>
                  <Grid Grid.Row="1" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="在修复实验室工作区中构建所选输出。只有“应用修复”成功后才会安装任何内容。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,0,8,0"/><Button x:Name="BtnFixLabRepair" Grid.Column="1" Content="修复" MinWidth="130" Padding="16,6" VerticalAlignment="Center"/></Grid>
                </Grid>
              </Expander>

              <Expander x:Name="ExpFixLabOutputs" Grid.Row="1" Grid.Column="1" IsExpanded="True" Background="{DynamicResource OutputBackground}" BorderBrush="{DynamicResource OutputBorder}" BorderThickness="1" Padding="9" Margin="4,0,0,8">
                <Expander.Header><StackPanel Margin="0,1"><TextBlock Text="4. 已构建输出" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingGreen}"/><TextBlock x:Name="TxtFixLabBuiltCount" Text="0 个变体" Foreground="{DynamicResource MutedText}" FontSize="11"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,6,0,0">
                  <TextBlock Text="已验证输出会保留，因此无需重新修复即可切换变体。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,0,0,4"/>
                  <ListBox x:Name="LstFixLabBuiltFixes" SelectionMode="Single" SelectedValuePath="BuildId" MinHeight="72" MaxHeight="130"><ListBox.ItemTemplate><DataTemplate>
                    <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><RadioButton VerticalAlignment="Center" IsHitTestVisible="False" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{DynamicResource MutedText}" FontSize="11"><Run Text="{Binding SizeMb}"/><Run Text="   "/><Run Text="{Binding BuiltDisplay}"/></TextBlock><TextBlock Text="{Binding ConfidenceText}" ToolTip="{Binding ConfidenceDetails}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding StatusGlyph}" VerticalAlignment="Center" Foreground="{Binding StatusColor}" FontSize="15" Margin="8,0,2,0"/></Grid>
                  </DataTemplate></ListBox.ItemTemplate></ListBox>
                  <Button x:Name="BtnFixLabApplyBuilt" Content="应用修复" Padding="14,6" Margin="0,6,0,0" HorizontalAlignment="Stretch"/>
                  <TextBlock Text="归档识别出的旧版来源，将修复后的 PAK 安装到 ~mods，并添加到 PMM 库。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander>

              <Expander x:Name="ExpFixLabBackups" Grid.Row="2" Grid.Column="0" IsExpanded="False" Background="{DynamicResource BackupBackground}" BorderBrush="{DynamicResource BackupBorder}" BorderThickness="1" Padding="9" Margin="0,0,4,0">
                <Expander.Header><StackPanel Margin="0,1"><TextBlock Text="5. 备份与恢复" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource WarmHeading}"/><TextBlock x:Name="TxtFixLabBackupCount" Text="0 个备份" Foreground="{DynamicResource MutedText}" FontSize="11"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,6,0,0"><TextBlock Text="应用修复提交修复时，旧版源模组会归档到这里。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,0,0,4"/><ListBox x:Name="LstFixLabBackups" SelectionMode="Single" MinHeight="68" MaxHeight="120"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CaseId}" FontSize="11" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="8,0,0,0"><TextBlock Text="{Binding SizeMb}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding CreatedDisplay}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="11"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Margin="0,5,0,0"><Button x:Name="BtnFixLabOpenBackupFolder" Content="打开备份文件夹"/><Button x:Name="BtnFixLabRevertBackup" Content="恢复原始模组"/></WrapPanel></StackPanel>
              </Expander>

              <Expander x:Name="ExpFixLabAdvanced" Grid.Row="2" Grid.Column="1" IsExpanded="False" Background="{DynamicResource AdvancedBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="9" Margin="4,0,0,0">
                <Expander.Header><StackPanel Margin="0,1"><TextBlock Text="6. 高级 / AI 修复交接" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}"/><TextBlock Text="用于不受支持修复案例的诊断、本地工作区文件和交接工具。" Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,6,0,0"><TextBlock x:Name="TxtFixLabIgnoredCount" Text="0 个已忽略来源" Foreground="{DynamicResource MutedText}" Margin="0,0,0,4"/><WrapPanel><Button x:Name="BtnFixLabCreateHandoff" Content="打开修复案例"/><Button x:Name="BtnFixLabOpenOutput" Content="打开当前任务输出"/><Button x:Name="BtnFixLabOpenRoot" Content="打开修复实验室文件夹"/><Button x:Name="BtnFixLabClearIgnored" Content="清除已忽略修复"/></WrapPanel></StackPanel>
              </Expander>

              <!-- Legacy/debug controls stay in the visual tree for runtime compatibility. -->
              <Grid Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed"><StackPanel>
                <ComboBox x:Name="CmbFixLabJob"/><Button x:Name="BtnFixLabRefreshJobs"/><Button x:Name="BtnFixLabOpenJob"/>
                <ListBox x:Name="LstFixLabPrimaryMods"/><Button x:Name="BtnFixLabUseLibraryMod"/><Button x:Name="BtnFixLabBrowsePrimary"/><TextBlock x:Name="TxtFixLabPrimary"/>
                <ListBox x:Name="LstFixLabRelated"/><Button x:Name="BtnFixLabAddRelated"/><Button x:Name="BtnFixLabRemoveRelated"/>
                <Button x:Name="BtnFixLabAnalyze"/><TextBlock x:Name="TxtFixLabAnalysis"/><DataGrid x:Name="DgFixLabPakInventory"/><ComboBox x:Name="CmbFixLabRecipe"/>
                <TextBlock x:Name="TxtFixLabBuildState"/><Button x:Name="BtnFixLabBuild"/><Button x:Name="BtnFixLabRebuild"/><Button x:Name="BtnFixLabAddOutputToLibrary"/>
              </StackPanel></Grid>
            </Grid>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="TabAIHelp">
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="AI 与帮助"/><Border x:Name="BrdAIHelpBadge" Background="{DynamicResource NoticeBorder}" CornerRadius="8" Margin="6,0,0,0" Padding="5,0" Visibility="Collapsed"><TextBlock x:Name="TxtAIHelpBadge" Text="0" Foreground="White" FontSize="10" FontWeight="Bold"/></Border></StackPanel></TabItem.Header>
        <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="3,0,3,8"><TextBlock Text="AI 与帮助" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="解决问题、为外部 AI 准备任务，或使用 PMM 创建内容。AIIO 以本地优先：不会上传任何内容，返回文件会作为不受信任的数据暂存。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/></StackPanel>
          <TabControl x:Name="AIHelpTabs" Grid.Row="1">
            <TabItem Header="AI 协助">
              <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="为出现故障的 PMM 功能打开一个案例，或启动单独的模组项目。PMM 会创建可检查的 ZIP 供手动共享；不会自动上传。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="2,0,2,8"/>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="280"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.25*" MinWidth="360"/></Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="AI 协助案例" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="选择诊断案例，或启动独立模组项目。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/></StackPanel><ListBox x:Name="LstAIHelpDiagnostics" Grid.Row="1" DisplayMemberPath="Display" Margin="0,7"/><WrapPanel Grid.Row="2"><Button x:Name="BtnAIHelpRefresh" Content="刷新"/><Button x:Name="BtnAIHelpNewCase" Content="新建案例"/><Button x:Name="BtnAIHelpNewModProject" Content="新建模组项目..." FontWeight="SemiBold"/><Button x:Name="BtnAIHelpPrepareDiagnostic" Content="打开案例"/></WrapPanel></Grid></Border>
                  <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
                  <Border Grid.Column="2" Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10"><Grid>
                    <StackPanel x:Name="PnlAIHelpSelectedCase"><TextBlock x:Name="TxtAIHelpSelectedCaseTitle" Text="未选择案例" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/><TextBlock x:Name="TxtAIHelpSelectedCaseMeta" Text="在左侧选择案例，或点击“新建案例”。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,8"/><Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="10" MinHeight="160"><TextBlock x:Name="TxtAIHelpSelectedCaseDescription" TextWrapping="Wrap"/></Border><TextBlock Text="打开案例后可选择 ZIP、MCP 或客户端，同时保留证据和历史记录。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    <StackPanel x:Name="PnlAIHelpNewCase" Visibility="Collapsed"><TextBlock Text="打开新的协助案例" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="选择 PMM 功能，然后描述发生了什么、预期结果以及复现方式。所选模组或构建仅是疑点，并非已确认原因。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/><ComboBox x:Name="CmbAIHelpDiagnosticType" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBox x:Name="TxtAIHelpDiagnosticTitle" Margin="0,6,0,0" ToolTip="Short title"/><TextBox x:Name="TxtAIHelpDiagnosticDescription" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" ToolTip="What happened, what you expected and how to reproduce it"/><CheckBox x:Name="ChkAIHelpIncludePalLog" Content="包含有限且已脱敏的 Palworld 日志摘要" Margin="0,7,0,2"/><WrapPanel><Button x:Name="BtnAIHelpCreateAndPrepareCase" Content="创建并打开案例" FontWeight="SemiBold"/><Button x:Name="BtnAIHelpCreateCase" Content="保存到本地"/><Button x:Name="BtnAIHelpCancelNewCase" Content="取消"/></WrapPanel><TextBlock x:Name="TxtAIHelpDiagnosticStatus" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                  </Grid></Border>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="AI 接收">
              <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Receive an AI response or a recognized self-describing artifact here. Standard response ZIPs route themselves to their existing exchange; a standalone theme can open as an uninstalled draft. Returned data stays inactive until you inspect and explicitly accept it." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="2,0,2,8"/>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.2*" MinWidth="380"/></Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="已知 AI 交换" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="历史记录会跨重启保留，并将每个请求、响应、候选和决策集中保存。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/></StackPanel><ListBox x:Name="LstAIIOSessions" Grid.Row="1" DisplayMemberPath="Display" MinHeight="70" Margin="0,7"/><TextBlock Grid.Row="2" Text="已接收候选" FontWeight="SemiBold" Margin="0,3,0,3"/><ListBox x:Name="LstAIIOCandidates" Grid.Row="3" DisplayMemberPath="Display" MinHeight="55"/><TextBlock x:Name="TxtAIIOCandidateStatus" Grid.Row="4" Text="返回内容在明确接受前均视为不受信任且未激活。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,4"/><WrapPanel Grid.Row="5"><Button x:Name="BtnAIIOOpenWorkspace" Content="打开 AI 工作区"/><Button x:Name="BtnAIIOOpenHandoff" Content="打开最新交接" IsEnabled="False"/><Button x:Name="BtnAIIOArchive" Content="归档交换"/><Button x:Name="BtnAIIOOpenCandidate" Content="检查候选"/><Button x:Name="BtnAIIOUseCandidate" Content="在合并中使用候选..." IsEnabled="False" FontWeight="SemiBold"/></WrapPanel></Grid></Border>
                  <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
                  <Border Grid.Column="2" Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="从 AI 接收" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="选择可识别的 PMM AI ZIP。PMM 会读取其内嵌身份，将标准响应路由到对应交换，或将独立主题作为未安装草稿打开。它不会执行返回代码，也不会自动部署返回的 PAK。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,10"/><Button x:Name="BtnAIIOImportResponse" Content="接收 AI 响应 ZIP..." HorizontalAlignment="Left" FontWeight="SemiBold" Padding="18,9"/><TextBlock Text="如果 AI 请求更多有限数据，请选择已路由的交换，并仅在此准备所请求的数据。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,5"/><Button x:Name="BtnAIIOContinue" Content="准备所请求的数据" HorizontalAlignment="Left"/><TextBlock x:Name="TxtAIIOStatus" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/><Grid Visibility="Collapsed"><StackPanel><ComboBox x:Name="CmbAIIOType" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBox x:Name="TxtAIIOTitle"/><TextBox x:Name="TxtAIIODescription"/><ComboBox x:Name="CmbAIOTargetKind" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBox x:Name="TxtAIOTargetId"/><Button x:Name="BtnAIIONewSession"/><Button x:Name="BtnAIIOPrepare"/></StackPanel></Grid></StackPanel></Border>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="反馈与知识" x:Name="TabHelpFeedback">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12" MaxWidth="1100">
                <TextBlock Text="创建可检查文件用于手动共享。本版本不会自动上传；禁用的上传控件仅表示未来连接点。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="2,0,2,8"/>
                <Border Style="{StaticResource SummaryCard}"><StackPanel>
                  <TextBlock Text="评论或报告" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="反馈类型" FontWeight="SemiBold" Margin="0,7,0,3"/>
                  <ComboBox x:Name="CmbAIHelpFeedbackType" DisplayMemberPath="Label" SelectedValuePath="Id"/>
                  <TextBlock Text="标题" FontWeight="SemiBold" Margin="0,7,0,3"/>
                  <TextBox x:Name="TxtAIHelpFeedbackTitle" ToolTip="Short title (optional if comments are provided)"/>
                  <TextBlock Text="评论" FontWeight="SemiBold" Margin="0,7,0,3"/>
                  <TextBox x:Name="TxtAIHelpFeedbackComments" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Comments, expected behavior, reproduction notes or Knowledge/CKL context"/>
                  <TextBlock Text="可选的精确合并上下文" FontWeight="SemiBold" Margin="0,8,0,3"/>
                  <ComboBox x:Name="CmbAIHelpFeedbackBuild" DisplayMemberPath="Display"/>
                  <WrapPanel Margin="0,7,0,0"><Button x:Name="BtnAIHelpCreateFeedback" Content="创建共享文件..." FontWeight="SemiBold"/><Button x:Name="BtnAIHelpOpenFeedback" Content="打开反馈文件夹"/><Button x:Name="BtnAIHelpUploadFeedback" Content="上传（未连接）" IsEnabled="False"/></WrapPanel>
                  <TextBlock x:Name="TxtAIHelpFeedbackStatus" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="3,8,3,3"><StackPanel><TextBlock Text="精确合并验证" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Exports the latest local PASS, PARTIAL or FAIL event for the selected deterministic build. Ordinary validation does not create a main AI &amp; Help alert." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,7"/><Button x:Name="BtnAIHelpGenerateFeedback" Content="创建精确验证反馈" HorizontalAlignment="Left"/></StackPanel></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="3,8,3,3"><StackPanel><TextBlock Text="知识 / CKL 贡献" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="After an imported solution has been tested in Palworld, package its handoff, candidate and exact runtime evidence for manual maintainer/community review." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,7"/><WrapPanel><Button x:Name="BtnExportKnowledgeContribution" Content="创建已测试贡献..."/><Button x:Name="BtnOpenKnowledgeContributions" Content="打开贡献文件夹"/></WrapPanel></StackPanel></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="3,8,3,3"><StackPanel><TextBlock Text="本地知识" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="TxtAIHelpKnowledgeSummary" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,3,0,0"/><WrapPanel Margin="0,7,0,0"><Button x:Name="BtnAIHelpOpenKnowledge" Content="打开知识库"/><Button x:Name="BtnOpenReviewCases" Content="打开 AI 审查案例"/></WrapPanel></StackPanel></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="3,8,3,3"><StackPanel><TextBlock Text="存储与可恢复性" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="TxtAIHelpStorageSummary" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,3,0,0"/><TextBlock Text="中断的操作" FontWeight="SemiBold" Margin="0,8,0,3"/><ListBox x:Name="LstAIHelpInterrupted" DisplayMemberPath="Display" MinHeight="60" MaxHeight="150"/><WrapPanel Margin="0,7,0,0"><Button x:Name="BtnAIHelpRefreshKnowledge" Content="刷新"/><Button x:Name="BtnAIHelpCleanup" Content="检查可清理内容"/></WrapPanel></StackPanel></Border>
              </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="配色方案编辑器" x:Name="TabHelpTheme"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="430"/></Grid.ColumnDefinitions>
              <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="创建或继续" FontSize="15" FontWeight="SemiBold"/><ComboBox x:Name="CmbThemeEditorSource" Grid.Row="1" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,7,0,0"/><Button x:Name="BtnThemeEditorNew" Grid.Row="2" Content="从所选方案新建" Margin="0,5,0,7"/><ListBox x:Name="LstThemeDrafts" Grid.Row="3" DisplayMemberPath="Display"/><WrapPanel Grid.Row="4" Margin="0,7,0,0"><Button x:Name="BtnThemeEditorLoad" Content="加载草稿"/><Button x:Name="BtnThemeEditorDelete" Content="删除草稿"/></WrapPanel></Grid></Border>
              <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
              <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4"><TextBlock Text="配色方案编辑器" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Every named brush keeps a required fallback color and may use a packaged PNG/JPEG image. Images are copied into the draft; external paths and URLs are forbidden." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBox x:Name="TxtThemeEditorName" ToolTip="方案名称"/><TextBox x:Name="TxtThemeEditorId" Grid.Column="2" ToolTip="小写方案 ID"/><ComboBox x:Name="CmbThemeEditorBase" Grid.Column="4"/></Grid><Border x:Name="BrdThemeEditorPreview" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,8,0,8"><StackPanel><TextBlock Text="Live preview uses the current whole-window theme after Preview. Save or install only when validation passes." TextWrapping="Wrap"/><WrapPanel Margin="0,6,0,0"><Button Content="普通按钮" IsHitTestVisible="False"/><Button Content="禁用按钮" IsEnabled="False"/><TextBox Width="180" Text="输入 / 选定颜色" IsReadOnly="True"/></WrapPanel></StackPanel></Border><StackPanel x:Name="PnlThemeEditorRows"/><TextBlock Text="主题协助案例" FontWeight="SemiBold" Margin="0,10,0,3"/><TextBox x:Name="TxtThemeEditorPrompt" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="描述提供给外部 AI 的视觉方向"/><WrapPanel Margin="0,7,0,0"><Button x:Name="BtnThemeEditorSave" Content="保存草稿"/><Button x:Name="BtnThemeEditorPreview" Content="预览"/><Button x:Name="BtnThemeEditorRevert" Content="还原预览"/><Button x:Name="BtnThemeEditorInstall" Content="本地安装" FontWeight="SemiBold"/><Button x:Name="BtnThemeEditorExport" Content="导出 JSON/ZIP"/><Button x:Name="BtnThemeEditorCreateAI" Content="打开案例"/><Button x:Name="BtnThemeEditorImportAI" Content="导入 AI 主题..."/></WrapPanel><TextBlock x:Name="TxtThemeEditorStatus" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></ScrollViewer>
            </Grid></TabItem>
            <TabItem Header="设置" x:Name="TabAISettings">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12" MaxWidth="1100">
                <TextBlock Text="Choose how the local AI &amp; Help module records real failures. No provider or upload connection is configured here." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="2,0,2,8"/>
<Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="本地 MCP 桥接（预览）" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Connect an AI client to this PMM installation. Enabling shares AIIO case summaries, staged files and current Vanilla reference through bounded tools. Returned files remain inactive. Review them before building or deploying. Connect local Codex below to process published requests automatically." TextWrapping="Wrap" Margin="0,7,0,0"/><WrapPanel Margin="0,8,0,0"><Button x:Name="BtnMCPEnable" Content="启用并准备连接" Margin="0,0,8,0"/><Button x:Name="BtnMCPDisable" Content="禁用 MCP" Margin="0,0,8,0"/><Button x:Name="BtnMCPOpen" Content="连接与暂存文件"/></WrapPanel><WrapPanel Margin="0,8,0,0"><Button x:Name="BtnMCPConnectCodex" Content="使用本地 Codex" Margin="0,0,8,0"/><Button x:Name="BtnMCPExternal" Content="仅外部客户端"/></WrapPanel><TextBlock Text="Local Codex uses your existing sign-in and account usage. Responses appear in the case for review." TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock x:Name="TxtMCPClientStatus" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock x:Name="TxtMCPStatus" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="可选 Unreal 集成" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="PMM works without Unreal. Enable this only to create and cook content with Unreal 5.1.1 and the Palworld Modding Kit. Python is included with Unreal." TextWrapping="Wrap" Margin="0,7,0,0"/><WrapPanel><Button x:Name="BtnUnrealPrepare" Content="准备 Unreal 集成"/><Button x:Name="BtnUnrealDisable" Content="保持 Unreal 关闭"/><Button x:Name="BtnUnrealInstall" Content="安装 / 打开 Epic Launcher"/><Button x:Name="BtnUnrealRunInstaller" Content="运行已验证的 Epic 安装程序..."/></WrapPanel><WrapPanel><Button x:Name="BtnUnrealEnginePath" Content="定位 Unreal..."/><Button x:Name="BtnUnrealWwiseSdk" Content="定位 Wwise SDK..."/><Button x:Name="BtnUnrealWwiseIntegration" Content="定位 Wwise 集成..."/><Button x:Name="BtnUnrealGuide" Content="安装指南"/><Button x:Name="BtnUnrealCandidates" Content="案例候选"/></WrapPanel><TextBlock x:Name="TxtUnrealStatus" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
<Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="诊断行为" FontSize="15" FontWeight="SemiBold"/><CheckBox x:Name="ChkAIIOAutoCreateErrorCases" Content="PMM 实际操作失败时创建或复用诊断案例" Margin="0,7,0,0"/><TextBlock Text="Identical repeated failures reuse one open case. Normal validation and Waiting for AI sessions never create a main-tab alert." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock x:Name="TxtAIIOSettingsStatus" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="3,8,3,3"><StackPanel><TextBlock Text="知识运行状态" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="TxtKnowledgeSummary" TextWrapping="Wrap" Margin="0,4,0,6" Foreground="{DynamicResource MutedText}"/><Button x:Name="BtnOpenKnowledge" Content="打开知识库" HorizontalAlignment="Left"/></StackPanel></Border>
              </StackPanel></ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>
      <TabItem Header="世界存档">
        <Grid Margin="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" MinWidth="360"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="430"/></Grid.ColumnDefinitions>
          <GroupBox Header="世界"><ListBox x:Name="LstSaves" DisplayMemberPath="Display"/></GroupBox>
          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition x:Name="RowSelectedSave" Height="*" MinHeight="36"/><RowDefinition x:Name="RowSavePaneSplitter" Height="6"/><RowDefinition x:Name="RowSaveBackups" Height="*" MinHeight="36"/></Grid.RowDefinitions>
            <Expander x:Name="ExpSelectedSave" Grid.Row="0" Header="选定存档" IsExpanded="True" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="8">
              <TextBox x:Name="TxtSaveDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Expander>
            <GridSplitter x:Name="SplSavePanes" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>
            <Expander x:Name="ExpSaveBackups" Grid.Row="2" Header="PMM 已创建备份 (0)" IsExpanded="True" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="8">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ListBox x:Name="LstSaveBackups" DisplayMemberPath="Display"/>
                  <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
                  <GroupBox Grid.Column="2" Header="选定备份详情" Margin="6,0,0,0"><TextBox x:Name="TxtSaveBackupDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="选择备份以查看日期、大小以及与当前存档的差异。"/></GroupBox>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource OutputBackground}" BorderBrush="{DynamicResource OutputBorder}" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,7,0,0">
                  <TextBlock x:Name="TxtSaveBackupStatus" Text="选择备份以查看日期、大小以及与当前存档的差异。" TextWrapping="Wrap" Foreground="{DynamicResource AccentHeadingGreen}"/>
                </Border>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,7,0,0">
                  <Button x:Name="BtnBackupSave" Content="创建备份" Padding="16,7"/>
                  <Button x:Name="BtnRestoreSave" Content="恢复所选备份" Padding="16,7" IsEnabled="False"/>
                  <Button x:Name="BtnOpenSaveBackupFolder" Content="打开备份文件夹" Padding="16,7" IsEnabled="False"/>
                </WrapPanel>
              </Grid>
            </Expander>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="设置" x:Name="TabSettings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Margin="14" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="界面" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="语言与工作区布局" Foreground="{DynamicResource MutedText}" Margin="0,2,0,7"/>
                <WrapPanel>
                  <ComboBox x:Name="CmbLanguage" Width="180" DisplayMemberPath="Label" SelectedValuePath="Code"/>
                  <Button x:Name="BtnApplyLanguage" Content="应用语言"/>
                  <Button x:Name="BtnResetLayout" Content="重置工作区布局" ToolTip="Reset window size and the draggable panel dividers"/>
                  <TextBlock Text="操作提示：" VerticalAlignment="Center" Margin="14,0,5,0"/>
                  <ComboBox x:Name="CmbActionHintDuration" Width="220" DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="0 disables the bubble; 1-120 seconds; Infinite stays until closed with ×."/>
                </WrapPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20,0,0,0">
                <Button x:Name="BtnRestoreDefaults" Content="恢复默认设置" MinWidth="130" ToolTip="Restore interface, ColorFlow hint and audio defaults. Language, paths, library and user data are not changed."/>
                <Button x:Name="BtnApplySettings" Content="应用更改" MinWidth="130" FontWeight="SemiBold" ToolTip="Apply theme, ColorFlow hint duration and completion sound without restarting PMM."/>
              </StackPanel>
            </Grid>
            <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,4,0,8">
              <StackPanel>
                <TextBlock Text="配色方案" FontSize="15.5" FontWeight="SemiBold"/>
                <TextBlock Text="Choose a scheme and press Apply changes. PMM Crystal is the fresh-install default. User JSON schemes can override the full palette and optionally the ColorFlow colors." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                <TextBlock Text="官方 PMM 方案" FontWeight="SemiBold" Margin="0,2,0,1"/>
                <WrapPanel x:Name="PnlThemeOptions" Margin="0,1,0,5"/>
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,1,0,6"><StackPanel><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="已添加的用户方案" FontWeight="SemiBold"/><TextBlock x:Name="TxtThemeInfo" Margin="12,0,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/></DockPanel><TextBlock x:Name="TxtUserThemeEmpty" Text="未安装用户方案。" Foreground="{DynamicResource MutedText}" Margin="0,5,0,0"/><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="PnlUserThemeOptions" Margin="0,5,0,0"/></ScrollViewer></StackPanel></Border>
                <WrapPanel><Button x:Name="BtnImportTheme" Content="添加方案..." ToolTip="Install reusable user schemes from JSON or ZIP."/><Button x:Name="BtnOpenThemesFolder" Content="打开方案文件夹"/></WrapPanel>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="声音事件" FontSize="15.5" FontWeight="SemiBold"/>
                <TextBlock Text="Configure each notification separately. Built-in sounds stay on the top row; sounds you add appear in the custom list below." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                <WrapPanel Margin="0,0,0,7" VerticalAlignment="Center">
                  <TextBlock Text="配置：" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <ComboBox x:Name="CmbSoundEventProfile" Width="285"/>
                  <CheckBox x:Name="ChkSoundEachAutoStep" Content="每个 AUTO 步骤播放声音" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="Play the Semiauto sound after every completed step while AUTO/SemiAUTO is running. Enabled by default; choose None or clear this option to mute it."/>
                  <CheckBox x:Name="ChkSoundAttention" Content="需要注意时播放声音" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </WrapPanel>
                <TextBlock x:Name="TxtSoundEventDescription" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                <TextBlock Text="内置声音" FontWeight="SemiBold" Margin="0,1,0,3"/>
                <WrapPanel Margin="0,0,0,6">
                  <RadioButton x:Name="RdoSoundNone" GroupName="PMMBuiltinSound" Tag="None" Content="无声音" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundBell" GroupName="PMMBuiltinSound" Tag="Bell" Content="铃声" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundMicrowave" GroupName="PMMBuiltinSound" Tag="Microwave" Content="微波炉完成音" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundMicrowave3" GroupName="PMMBuiltinSound" Tag="Microwave3" Content="3 声提示" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundOk" GroupName="PMMBuiltinSound" Tag="Ok" Content="OK" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundGood" GroupName="PMMBuiltinSound" Tag="Good" Content="好" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundCrystal" GroupName="PMMBuiltinSound" Tag="Crystal" Content="水晶铃声" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundAlert" GroupName="PMMBuiltinSound" Tag="Alert" Content="短提示音" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundCustom" GroupName="PMMBuiltinSound" Content="选择自定义" Margin="0,2,14,2"/>
                </WrapPanel>
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,1,0,6">
                  <StackPanel>
                    <DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="已添加的自定义声音" FontWeight="SemiBold"/><TextBlock x:Name="TxtSoundInfo" Margin="12,0,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/></DockPanel>
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="PnlCustomSoundOptions" Margin="0,5,0,0"/></ScrollViewer>
                  </StackPanel>
                </Border>
                <WrapPanel><Button x:Name="BtnImportSound" Content="添加声音..."/><Button x:Name="BtnOpenSoundsFolder" Content="打开声音文件夹"/><Button x:Name="BtnTestCompletionSound" Content="测试声音"/></WrapPanel>
                <WrapPanel Margin="0,7,0,0" VerticalAlignment="Center"><TextBlock Text="音量：" VerticalAlignment="Center" Margin="0,0,7,0"/><Slider x:Name="SldCompletionVolume" Width="300" Minimum="0" Maximum="100" Value="50" TickFrequency="10" VerticalAlignment="Center"/><TextBlock x:Name="TxtCompletionVolume" Text="50%" Width="48" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></WrapPanel>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="原版游戏参考" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Optional reusable research reference built locally from your own Pal-Windows.pak. It does not modify Palworld and normal AI handoffs include only the bounded files they require." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                <TextBlock x:Name="TxtGameReferenceSummary" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{DynamicResource MutedText}"/>
                <WrapPanel><Button x:Name="BtnBuildGameReference" Content="构建 / 刷新游戏参考"/><Button x:Name="BtnOpenGameReference" Content="打开游戏参考文件夹"/></WrapPanel>
                <WrapPanel Margin="0,5,0,0"><Button x:Name="BtnImportMappings" Content="导入映射 (.usmap)"/><Button x:Name="BtnBundledMappings" Content="使用内置映射"/></WrapPanel>
                <TextBlock x:Name="TxtGameReferenceProgress" Margin="0,7,0,2" Foreground="{DynamicResource MutedText}" Visibility="Collapsed" TextWrapping="Wrap"/>
                <ProgressBar x:Name="PrgGameReference" Height="10" HorizontalAlignment="Stretch" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50"/>
              </StackPanel>
            </Border>

            <Separator Margin="0,8"/>
            <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="11">
              <StackPanel>
                <TextBlock Text="Palworld 安装" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Automatic detection is recommended. Manual Steam and Palworld selectors are available here for unusual installations." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                <TextBox x:Name="TxtGamePath" IsReadOnly="True" Margin="0,0,0,6"/>
                <WrapPanel>
                  <Button x:Name="BtnDetectGameSettings" Content="自动检测"/>
                  <Button x:Name="BtnBrowseGame" Content="选择 Steam 文件夹..."/>
                  <Button x:Name="BtnBrowseGameManual" Content="选择 Palworld 文件夹..."/>
                  <Button x:Name="BtnOpenGameSettings" Content="打开游戏文件夹"/>
                  <Button x:Name="BtnOpenModsSettings" Content="打开模组文件夹"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border x:Name="PnlLibrarySettings" Style="{StaticResource SummaryCard}"><StackPanel><Separator Margin="0,8"/>
            <TextBlock Text="便携库" FontSize="16" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtLibraryPath" IsReadOnly="True" Margin="0,5" HorizontalAlignment="Stretch"/>
            <Button x:Name="BtnOpenLibrary" Content="打开库" HorizontalAlignment="Left"/>

            </StackPanel></Border>
            <Border x:Name="PnlBaseDependencySettings" Style="{StaticResource SummaryCard}"><StackPanel><Separator Margin="0,12"/>
            <TextBlock Text="依赖项" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Start checks dependencies automatically and prepares/downloads only what is missing. This button forces a manual repair." TextWrapping="Wrap" Margin="0,4,0,6" Foreground="{DynamicResource MutedText}"/>
            <Button x:Name="BtnSetupDeps" Content="准备 / 修复依赖项" HorizontalAlignment="Left"/>

            </StackPanel></Border>
            <Separator Margin="0,12"/>
            <TextBlock Text="Recent log — support file: Workspace\Logs\PalModMerger.log" FontSize="16" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtLog" Height="280" HorizontalAlignment="Stretch" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="{DynamicResource StatusBackground}" CornerRadius="4" Padding="7,4">
      <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource PrimaryText}"/>
    </Border>
  </Grid>
</Window>
