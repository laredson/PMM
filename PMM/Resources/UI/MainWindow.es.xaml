          <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" MinWidth="360"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="430"/></Grid.ColumnDefinitions>
          <GroupBox Header="Mundos"><ListBox x:Name="LstSaves" DisplayMemberPath="Display"/></GroupBox>
          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition x:Name="RowSelectedSave" Height="*" MinHeight="36"/><RowDefinition x:Name="RowSavePaneSplitter" Height="6"/><RowDefinition x:Name="RowSaveBackups" Height="*" MinHeight="36"/></Grid.RowDefinitions>
            <Expander x:Name="ExpSelectedSave" Grid.Row="0" Header="Save seleccionado" IsExpanded="True" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="8">
              <TextBox x:Name="TxtSaveDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Expander>
            <GridSplitter x:Name="SplSavePanes" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>
            <Expander x:Name="ExpSaveBackups" Grid.Row="2" Header="Backups PMM creados (0)" IsExpanded="True" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="8">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ListBox x:Name="LstSaveBackups" DisplayMemberPath="Display"/>
                  <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
                  <GroupBox Grid.Column="2" Header="Detalles del backup seleccionado" Margin="6,0,0,0"><TextBox x:Name="TxtSaveBackupDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Selecciona un backup para ver fecha, tamano y diferencia frente al save actual."/></GroupBox>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource OutputBackground}" BorderBrush="{DynamicResource OutputBorder}" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,7,0,0">
                  <TextBlock x:Name="TxtSaveBackupStatus" Text="Selecciona un backup para ver fecha, tamano y diferencia frente al save actual." TextWrapping="Wrap" Foreground="{DynamicResource AccentHeadingGreen}"/>
                </Border>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,7,0,0">
                  <Button x:Name="BtnBackupSave" Content="Crear backup" Padding="16,7"/>
                  <Button x:Name="BtnRestoreSave" Content="Restaurar backup seleccionado" Padding="16,7" IsEnabled="False"/>
                  <Button x:Name="BtnOpenSaveBackupFolder" Content="Abrir carpeta de backups" Padding="16,7" IsEnabled="False"/>
                </WrapPanel>
              </Grid>
            </Expander>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Configuracion">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Margin="14" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Interfaz" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Idioma y distribución del espacio de trabajo" Foreground="{DynamicResource MutedText}" Margin="0,2,0,7"/>
                <WrapPanel>
                  <ComboBox x:Name="CmbLanguage" Width="180" DisplayMemberPath="Label" SelectedValuePath="Code"/>
                  <Button x:Name="BtnApplyLanguage" Content="Aplicar idioma"/>
                  <Button x:Name="BtnResetLayout" Content="Restablecer distribución" ToolTip="Restablece el tamaño de la ventana y los divisores arrastrables"/>
                  <TextBlock Text="Globo de acción:" VerticalAlignment="Center" Margin="14,0,5,0"/>
                  <ComboBox x:Name="CmbActionHintDuration" Width="220" DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="0 lo desactiva; 1-120 segundos; Infinito permanece hasta cerrarlo con ×."/>
                </WrapPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20,0,0,0">
                <Button x:Name="BtnRestoreDefaults" Content="Restaurar valores" MinWidth="130" ToolTip="Restaura los valores de interfaz, aviso ColorFlow y audio. No cambia idioma, rutas, biblioteca ni datos del usuario."/>
                <Button x:Name="BtnApplySettings" Content="Aplicar cambios" MinWidth="130" FontWeight="SemiBold" ToolTip="Aplica tema, duración del aviso ColorFlow y sonido sin reiniciar PMM."/>
              </StackPanel>
            </Grid>
            <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,4,0,8">
              <StackPanel>
                <TextBlock Text="Esquema de color" FontSize="15.5" FontWeight="SemiBold"/>
                <TextBlock Text="Elige un esquema y pulsa Aplicar cambios. PMM Crystal es el predeterminado en instalaciones nuevas. Los JSON del usuario pueden cambiar toda la paleta y, opcionalmente, los colores de ColorFlow." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                <TextBlock Text="Esquemas oficiales de PMM" FontWeight="SemiBold" Margin="0,2,0,1"/>
                <WrapPanel x:Name="PnlThemeOptions" Margin="0,1,0,5"/>
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,1,0,6"><StackPanel><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="Esquemas añadidos por el usuario" FontWeight="SemiBold"/><TextBlock x:Name="TxtThemeInfo" Margin="12,0,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/></DockPanel><TextBlock x:Name="TxtUserThemeEmpty" Text="No hay esquemas del usuario instalados." Foreground="{DynamicResource MutedText}" Margin="0,5,0,0"/><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="PnlUserThemeOptions" Margin="0,5,0,0"/></ScrollViewer></StackPanel></Border>
                <WrapPanel><Button x:Name="BtnImportTheme" Content="Agregar esquema..." ToolTip="Instala esquemas reutilizables del usuario desde JSON o ZIP."/><Button x:Name="BtnOpenThemesFolder" Content="Abrir carpeta de esquemas"/></WrapPanel>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Eventos de sonido" FontSize="15.5" FontWeight="SemiBold"/>
                <TextBlock Text="Configura cada tipo de aviso por separado. Los sonidos integrados estan siempre disponibles; los que agregues aparecen en la lista custom inferior." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                <WrapPanel Margin="0,0,0,7" VerticalAlignment="Center">
                  <TextBlock Text="Configurar:" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <ComboBox x:Name="CmbSoundEventProfile" Width="285"/>
                  <CheckBox x:Name="ChkSoundEachAutoStep" Content="Sonido en cada paso de AUTO" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="Reproduce el sonido Semiauto tras cada paso completado durante AUTO/Auto ON. Activado por defecto; elige Ninguno o desmarca esta opcion para silenciarlo."/>
                  <CheckBox x:Name="ChkSoundAttention" Content="Sonido cuando se requiera atencion" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </WrapPanel>
                <TextBlock x:Name="TxtSoundEventDescription" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                <TextBlock Text="Sonidos integrados" FontWeight="SemiBold" Margin="0,1,0,3"/>
                <WrapPanel Margin="0,0,0,6">
                  <RadioButton x:Name="RdoSoundNone" GroupName="PMMBuiltinSound" Tag="None" Content="Sin sonido" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundBell" GroupName="PMMBuiltinSound" Tag="Bell" Content="Campana" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundMicrowave" GroupName="PMMBuiltinSound" Tag="Microwave" Content="Final de microondas" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundMicrowave3" GroupName="PMMBuiltinSound" Tag="Microwave3" Content="3 pitidos" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundOk" GroupName="PMMBuiltinSound" Tag="Ok" Content="OK" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundGood" GroupName="PMMBuiltinSound" Tag="Good" Content="Good" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundCrystal" GroupName="PMMBuiltinSound" Tag="Crystal" Content="Campanilla" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundAlert" GroupName="PMMBuiltinSound" Tag="Alert" Content="Alerta corta" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundCustom" GroupName="PMMBuiltinSound" Content="Elegir custom" Margin="0,2,14,2"/>
                </WrapPanel>
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,1,0,6">
                  <StackPanel>
                    <DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="Sonidos custom agregados" FontWeight="SemiBold"/><TextBlock x:Name="TxtSoundInfo" Margin="12,0,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/></DockPanel>
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="PnlCustomSoundOptions" Margin="0,5,0,0"/></ScrollViewer>
                  </StackPanel>
                </Border>
                <WrapPanel><Button x:Name="BtnImportSound" Content="Agregar sonido..."/><Button x:Name="BtnOpenSoundsFolder" Content="Abrir carpeta de sonidos"/><Button x:Name="BtnTestCompletionSound" Content="Probar sonido"/></WrapPanel>
                <WrapPanel Margin="0,7,0,0" VerticalAlignment="Center"><TextBlock Text="Volumen:" VerticalAlignment="Center" Margin="0,0,7,0"/><Slider x:Name="SldCompletionVolume" Width="300" Minimum="0" Maximum="100" Value="50" TickFrequency="10" VerticalAlignment="Center"/><TextBlock x:Name="TxtCompletionVolume" Text="50%" Width="48" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></WrapPanel>
              </StackPanel>
            </Border>

            <Separator Margin="0,8"/>
            <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="11">
              <StackPanel>
                <TextBlock Text="Instalación de Palworld" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Se recomienda la detección automática. Los selectores manuales de Steam y Palworld están aquí para instalaciones poco habituales." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                <TextBox x:Name="TxtGamePath" IsReadOnly="True" Margin="0,0,0,6"/>
                <WrapPanel>
                  <Button x:Name="BtnDetectGameSettings" Content="Detectar automáticamente"/>
                  <Button x:Name="BtnBrowseGame" Content="Elegir carpeta de Steam..."/>
                  <Button x:Name="BtnBrowseGameManual" Content="Elegir carpeta de Palworld..."/>
                  <Button x:Name="BtnOpenGameSettings" Content="Abrir carpeta del juego"/>
                  <Button x:Name="BtnOpenModsSettings" Content="Abrir carpeta de mods"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="Vanilla Game Reference" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Referencia de investigacion opcional y reutilizable creada localmente desde tu propio Pal-Windows.pak. No modifica Palworld y los handoffs IA normales solo incluyen los archivos acotados que necesitan." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                <TextBlock x:Name="TxtGameReferenceSummary" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{DynamicResource MutedText}"/>
                <WrapPanel><Button x:Name="BtnBuildGameReference" Content="Crear / actualizar Game Reference"/><Button x:Name="BtnOpenGameReference" Content="Abrir carpeta Game Reference"/></WrapPanel>
                <TextBlock x:Name="TxtGameReferenceProgress" Margin="0,7,0,2" Foreground="{DynamicResource MutedText}" Visibility="Collapsed" TextWrapping="Wrap"/>
                <ProgressBar x:Name="PrgGameReference" Height="10" HorizontalAlignment="Stretch" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50"/>
              </StackPanel>
            </Border>


            <Separator Margin="0,8"/>
            <TextBlock Text="Biblioteca portable" FontSize="16" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtLibraryPath" IsReadOnly="True" Margin="0,5" HorizontalAlignment="Stretch"/>
            <Button x:Name="BtnOpenLibrary" Content="Abrir biblioteca" HorizontalAlignment="Left"/>

            <Separator Margin="0,12"/>
            <TextBlock Text="Dependencias" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Start comprueba las dependencias automaticamente y solo prepara/descarga lo que falta. Este boton fuerza una reparacion manual." TextWrapping="Wrap" Margin="0,4,0,6" Foreground="{DynamicResource MutedText}"/>
            <Button x:Name="BtnSetupDeps" Content="Preparar / reparar dependencias" HorizontalAlignment="Left"/>

            <Separator Margin="0,12"/>
            <TextBlock Text="Log reciente — archivo para soporte: Workspace\Logs\PalModMerger.log" FontSize="16" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtLog" Height="280" HorizontalAlignment="Stretch" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="{DynamicResource StatusBackground}" CornerRadius="4" Padding="7,4">
      <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource PrimaryText}"/>
    </Border>
  </Grid>
</Window>
