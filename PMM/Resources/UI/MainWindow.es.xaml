<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PMM - Palworld Manager Merger v1.3.0"
        Width="1460" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" ShowActivated="True"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI"
        FontSize="13">
  <!--
    Interfaz v1.1.1: el motor de merge permanece conservador; los adapters validados no cambian.
    El espacio de trabajo es redimensionable y explica el plan de Analizar
    asset por asset en lugar de mostrar solamente una linea de resumen.
  -->
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#EAF0F7"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#F8FBFF"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardAltBackground" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#D5DAE0"/>
    <SolidColorBrush x:Key="InputBorder" Color="#C5CBD2"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#17202A"/>
    <SolidColorBrush x:Key="MutedText" Color="#5F6B76"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#DDEBFF"/>
    <SolidColorBrush x:Key="SelectionText" Color="#152238"/>
    <SolidColorBrush x:Key="GridLine" Color="#E6E9ED"/>
    <SolidColorBrush x:Key="Splitter" Color="#DDE2E8"/>
    <SolidColorBrush x:Key="StatusBackground" Color="#E9EDF2"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#2E9D50"/>
    <SolidColorBrush x:Key="SoftBlue" Color="#EEF4FF"/>
    <SolidColorBrush x:Key="SoftGreen" Color="#ECF8EF"/>
    <SolidColorBrush x:Key="SoftAmber" Color="#FFF7E6"/>
    <SolidColorBrush x:Key="SoftRed" Color="#FFF0F0"/>
    <SolidColorBrush x:Key="SoftGray" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="FixHeaderBackground" Color="#EEF3F8"/>
    <SolidColorBrush x:Key="FixHeaderBorder" Color="#C9D5E2"/>
    <SolidColorBrush x:Key="NoticeBackground" Color="#FFF7ED"/>
    <SolidColorBrush x:Key="NoticeBorder" Color="#F2B56B"/>
    <SolidColorBrush x:Key="SourceBackground" Color="#F4F8FF"/>
    <SolidColorBrush x:Key="SourceBorder" Color="#CAD8EA"/>
    <SolidColorBrush x:Key="ConfigureBackground" Color="#FFF9EE"/>
    <SolidColorBrush x:Key="ConfigureBorder" Color="#E8D6AE"/>
    <SolidColorBrush x:Key="BuildBackground" Color="#F7F5FF"/>
    <SolidColorBrush x:Key="BuildBorder" Color="#D8D1EF"/>
    <SolidColorBrush x:Key="OutputBackground" Color="#F1FAF3"/>
    <SolidColorBrush x:Key="OutputBorder" Color="#C8E2CE"/>
    <SolidColorBrush x:Key="BackupBackground" Color="#FAF8F5"/>
    <SolidColorBrush x:Key="BackupBorder" Color="#DDD7CF"/>
    <SolidColorBrush x:Key="AdvancedBackground" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="AccentHeadingBlue" Color="#284B73"/>
    <SolidColorBrush x:Key="AccentHeadingAmber" Color="#7A551A"/>
    <SolidColorBrush x:Key="AccentHeadingPurple" Color="#51427C"/>
    <SolidColorBrush x:Key="AccentHeadingGreen" Color="#2F6B3B"/>
    <SolidColorBrush x:Key="WarmHeading" Color="#62584C"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#111827"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#CBD5E1"/>

    <Style x:Key="DefaultButton" TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}"/>

    <Style x:Key="ImportButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#7C3AED"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#6D28D9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#6D28D9"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#1D4ED8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BuildButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#D97706"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#B45309"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B45309"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DeployButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#2E9D50"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#258342"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#258342"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#0F9D8A"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0F766E"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0F766E"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0" Margin="7,2,3,2" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                  <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="360">
                  <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PriorityEditorTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Margin" Value="3,1"/>
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="MaxLength" Value="18"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Margin="0,0,2,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderBrush" Value="{DynamicResource GridLine}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Background" Value="{DynamicResource CardBorder}"/>
    </Style>
    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource Splitter}"/>
      <Setter Property="ShowsPreview" Value="True"/>
    </Style>
    <Style x:Key="SummaryCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10">
      <Grid x:Name="GrdHeaderLayout">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="4,0,22,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="ImgPMMLogo" Grid.Column="0" Width="148" Height="148" Stretch="Uniform" Margin="0,0,20,0" SnapsToDevicePixels="True"/><StackPanel x:Name="PnlHeaderTitle" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="PALWORLD" FontFamily="Bahnschrift SemiBold" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" LineHeight="33"/><TextBlock Text="MANAGER" FontFamily="Bahnschrift SemiBold" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" LineHeight="33"/><TextBlock Text="MERGER" FontFamily="Bahnschrift SemiBold" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" LineHeight="33"/><TextBlock Text="Gestor de mods de Palworld y fusionador de compatibilidad" Foreground="{DynamicResource MutedText}" FontSize="14" Margin="1,5,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
        <Grid x:Name="GrdHeaderActions" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Button x:Name="BtnDetectGame" Grid.Row="0" HorizontalAlignment="Stretch" MinWidth="0" Padding="12,7" Margin="0,0,0,6" ToolTip="Detecta Palworld automáticamente. Si la detección falla, PMM te permite elegir una carpeta de Steam o Palworld.">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}">
                <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                <Setter Property="Opacity" Value="1"/>
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="1"/></Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel>
              <TextBlock x:Name="TxtGamePathStatus" Text="Palworld no detectado - pulsa para detectar" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="Detectar automáticamente o configurar la instalación desde Opciones." Foreground="{DynamicResource MutedText}" FontSize="11.5" TextAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
          </Button>
          <Border Grid.Row="2" Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" Padding="8,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel VerticalAlignment="Center"><CheckBox x:Name="TglAutoMode" Content="Auto ON" VerticalAlignment="Center" Margin="2,0,12,0" ToolTip="Al activarlo, una acción del flujo iniciada manualmente continúa automáticamente por los pasos seguros restantes."/><CheckBox x:Name="ChkAutoPlay" Content="Ejecutar Palworld tras Deploy" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Inicia Palworld después del Deploy final correcto de una ejecución automática."/></WrapPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnAutoRun" Content="AUTO" Style="{StaticResource DefaultButton}" MinWidth="82" FontWeight="Bold" ToolTip="Ejecuta una sola vez todos los pasos seguros restantes desde el estado actual sin activar Auto ON."/><Button x:Name="BtnCancelOperation" Content="CANCELAR" MinWidth="92" IsEnabled="False" ToolTip="Cancela la operación actual o el flujo automático. Deploy hace rollback si el commit ya había comenzado."/></StackPanel></Grid></Border>
          <UniformGrid Grid.Row="1" Columns="3" HorizontalAlignment="Stretch" Margin="0,0,0,6"><Button x:Name="BtnOpenGame" Content="Abrir carpeta del juego"/><Button x:Name="BtnOpenModsFolder" Content="Abrir carpeta de mods"/><Button x:Name="BtnPlay" Content="Iniciar Palworld" Padding="16,6"/></UniformGrid>
        </Grid>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,10,0,8" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource PrimaryText}">
      <TabItem Header="Mods &amp; Merge">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColLibrary" Width="2*" MinWidth="290" MaxWidth="520"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition x:Name="ColAnalysisWorkspace" Width="3*" MinWidth="460"/>
          </Grid.ColumnDefinitions>

          <!-- Source library. PMM patches are deliberately rendered separately below. -->
          <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="6"/>
                <RowDefinition x:Name="RowPatches" Height="180" MinHeight="110" MaxHeight="520"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Biblioteca de mods" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock x:Name="TxtLibraryCount" Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                  <Button x:Name="BtnImport" Content="Importar..." ToolTip="Elige uno o varios PAK/ZIP/7Z/RAR, o todos los mods compatibles de una carpeta"/>
                  <Button x:Name="BtnImportGameMods" Content="Importar ~mods" ToolTip="Copiar los PAK actuales del juego a la biblioteca PMM"/>
                  <Button x:Name="BtnScan" Content="Analizar" Padding="16,5"/>
                </WrapPanel>
              </Grid>

              <Grid Grid.Row="1" Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TxtModFilter" ToolTip="Filtrar mods fuente por nombre o estado"/>
                <TextBlock Grid.Column="1" Text="Filtro" VerticalAlignment="Center" Margin="8,0,2,0" Foreground="{DynamicResource MutedText}"/>
              </Grid>

              <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DataGrid x:Name="LstMods" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" AlternationCount="2" AllowDrop="True" HorizontalGridLinesBrush="{DynamicResource GridLine}" ToolTip="Ctrl/Shift permiten seleccionar varios mods; Ctrl+A selecciona todos. Orden de merge: arrastra una fila o escribe otro numero en Orden. Arriba se aplica antes; abajo tiene mayor prioridad.">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                    <Style.Triggers>
                      <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource CardAltBackground}"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
                      <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value="0.58"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Activo" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Los mods fuente activos participan en Analizar, Build y Deploy"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Orden" Width="66" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Priority, Mode=OneWay}" Tag="{Binding Name}" Style="{StaticResource PriorityEditorTextBox}" ToolTip="Escribe una nueva posicion de merge. Los valores menores que 1 pasan a 1; los mayores que el numero de mods pasan a la ultima posicion."/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="MB" Binding="{Binding SizeText}" Width="72" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Hash" Binding="{Binding HashShort}" Width="105" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>

              <StackPanel Grid.Row="1" Margin="0,7,0,0">
                <WrapPanel HorizontalAlignment="Center">
                  <Button x:Name="BtnSelectAllMods" Content="Seleccionar todos" IsEnabled="False"/>
                  <Button x:Name="BtnClearModSelection" Content="Ninguno" IsEnabled="False"/>
                  <Button x:Name="BtnEnableMods" Content="Activar seleccionados" IsEnabled="False"/>
                  <Button x:Name="BtnDisableMods" Content="Desactivar seleccionados" IsEnabled="False"/>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                  <Button x:Name="BtnPriorityUp" Content="Antes / menos prioridad" IsEnabled="False" ToolTip="Mueve este mod hacia arriba: su diff se aplica antes"/>
                  <Button x:Name="BtnPriorityDown" Content="Despues / mas prioridad" IsEnabled="False" ToolTip="Mueve este mod hacia abajo: gana los valores realmente solapados"/>
                  <Button x:Name="BtnDeleteMod" Content="Borrar seleccionados" IsEnabled="False"/>
                  <ComboBox x:Name="CmbLibraryOrder" Width="188" Margin="3" ToolTip="Reordena toda la biblioteca importada. Cambiar el orden invalida Analyze."/>
                  <Button x:Name="BtnReorderLibrary" Content="Reordenar" IsEnabled="True" ToolTip="Reordena toda la biblioteca importada. Cambiar el orden invalida Analyze."/>
                </WrapPanel>
              </StackPanel>


              </Grid>

              <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

              <Border Grid.Row="4" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource CardAltBackground}" Padding="6">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="1,0,1,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Parches de compatibilidad" FontWeight="SemiBold"/>
                      <TextBlock x:Name="TxtPatchCount" Foreground="{DynamicResource MutedText}" FontSize="11.5"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                      <Button x:Name="BtnValidatePatch" Content="Validar merge" Padding="8,3" MinHeight="26" IsEnabled="False" ToolTip="Marca el merge seleccionado como probado y funcional en runtime."/>
                      <Button x:Name="BtnDeletePatch" Content="Borrar merge" Padding="8,3" MinHeight="26" IsEnabled="False" ToolTip="Borra la copia desplegada exacta si existe y todas las copias guardadas coincidentes dentro de PMM."/>
                    </WrapPanel>
                  </Grid>
                  <TextBlock Grid.Row="1" Margin="2,0,2,4" FontSize="10.5" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Text="Elige un overlay guardado o Sin parche de compatibilidad para desplegar solo mods fuente. Un merge PMM externo ya desplegado puede inspeccionarse, retirarse o borrarse aunque no sea seleccionable para Deploy; solo hashes fuente + mappings exactos permiten reutilizar un build."/>
                  <DataGrid x:Name="LstPatches" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" FontSize="11" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="Usar" Width="42">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><RadioButton GroupName="PMMPatchSelection" IsChecked="{Binding Selected, Mode=OneWay}" IsEnabled="{Binding Selectable}" Tag="{Binding SelectionKey}" ToolTip="{Binding SelectTip}" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Parche" Binding="{Binding Name}" Width="*" MinWidth="135" IsReadOnly="True"/>
                      <DataGridTextColumn Header="Decision" Binding="{Binding DecisionSummary}" Width="130" IsReadOnly="True"/>
                      <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="150" IsReadOnly="True"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>

            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

          <!-- Analysis is the dominant workspace. Conflict and unsupported sections collapse when unused. -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="RowAnalysisWorkspace" Height="*"/>
              <RowDefinition x:Name="RowAnalysisConflictSplitter" Height="0"/>
              <RowDefinition x:Name="RowResolutionWorkspace" Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition x:Name="RowWorkspaceFiller" Height="0"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Expander x:Name="ExpAnalysis" Grid.Row="0" Header="Plan de analisis" IsExpanded="True" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtAnalysisHeadline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="3,0,3,5"/>
                <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,5">
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftBlue}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtSharedCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Compartidos" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftGreen}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtAutoCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Auto merge" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftAmber}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtDecisionCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Decisiones" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftRed}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtUnsupportedCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="No soportados" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource BuildBackground}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtExperimentalCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Experimental" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtIdenticalCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Identicos" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                </UniformGrid>

                <TextBlock x:Name="TxtAnalysisScope" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="3,0,3,6"/>
                <StackPanel Grid.Row="3" Margin="3,0,3,5">
                  <TextBlock x:Name="TxtAnalyzeProgress" Text="" Foreground="{DynamicResource MutedText}"/>
                  <ProgressBar x:Name="PrgAnalyze" Height="10" Margin="0,3,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50"/>
                </StackPanel>

                <DataGrid x:Name="DgAnalysisAssets" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowDetailsVisibilityMode="VisibleWhenSelected" EnableRowVirtualization="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="125"/>
                    <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="1.25*"/>
                    <DataGridTextColumn Header="Adapter" Binding="{Binding Adapter}" Width="145"/>
                    <DataGridTextColumn Header="Mods implicados" Binding="{Binding Providers}" Width="1.7*"/>
                    <DataGridTextColumn Header="Cambios" Binding="{Binding Changes}" Width="105"/>
                  </DataGrid.Columns>
                  <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,1" Padding="10,7">
                        <StackPanel>
                          <TextBlock Text="{Binding FullAsset}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Details}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </DataGrid.RowDetailsTemplate>
                </DataGrid>
              </Grid>
            </Expander>

            <GridSplitter x:Name="SplAnalysisResolution" Grid.Row="1" Height="6" Margin="0,3,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Visibility="Collapsed"/>

            <Expander x:Name="ExpConflicts" Grid.Row="2" Margin="0,6,0,0" IsExpanded="False" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="6">
              <Expander.Header><TextBlock x:Name="TxtConflictHeader" Text="Resolucion y revision (0)" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/></Expander.Header>
              <Grid MinHeight="175" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="ColConflictAssets" Width="250" MinWidth="175"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*" MinWidth="360"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="LstConflictAssets" Grid.Column="0" DisplayMemberPath="Display"/>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
                <Grid Grid.Column="2" Margin="8,0,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock x:Name="TxtConflictMods" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="TxtConflictAsset" Grid.Row="1" Margin="0,3,0,7" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                  <WrapPanel Grid.Row="2" Margin="0,0,0,7" VerticalAlignment="Center">
                    <TextBlock Text="Aplicar a todos:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbBulkWinner" Width="190" Margin="0,0,6,0"/>
                    <TextBlock Text="Custom:" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <TextBox x:Name="TxtBulkCustom" Width="110" Margin="0,0,6,0" ToolTip="Se usa solo cuando seleccionas Custom"/>
                    <Button x:Name="BtnApplyBulk" Content="Aplicar a todas las filas"/>
                    <Button x:Name="BtnOpenReview" Content="Abrir archivos de revision"/>
                  </WrapPanel>
                  <DataGrid x:Name="DgDecisions" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="CellOrRowHeader" IsReadOnly="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
                </Grid>
              </Grid>
            </Expander>

            <Expander x:Name="ExpUnsupported" Grid.Row="3" Header="Assets compartidos bloqueados (0)" Margin="0,6,0,0" IsExpanded="False" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="6">
              <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="LstUnsupportedAssets" Grid.Row="0" MaxHeight="86" DisplayMemberPath="Display"/>
                <TextBox x:Name="TxtUnsupported" Grid.Row="1" Margin="0,5,0,5" MaxHeight="90" MinHeight="42" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardAltBackground}"/>
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Desactivar fuente:" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <ComboBox x:Name="CmbUnsupportedDisable" Grid.Column="1" Margin="0,0,7,0"/>
                  <Button x:Name="BtnDisableUnsupported" Grid.Column="2" Content="Desactivar mod seleccionado y Analizar" Style="{StaticResource PrimaryButton}" Padding="10,4"/>
                  <TextBlock x:Name="TxtUnsupportedHint" Grid.Column="3" Text="Cuando un asset no esta soportado, PMM puede sugerir la fuente cuya retirada altera menos merges compartidos ya compatibles. Es una sugerencia estructural, no una opinion sobre gameplay." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Margin="10,0,0,0"/>
                </Grid>
                <WrapPanel Grid.Row="3" Margin="0,5,0,0">
                  <Button x:Name="BtnOpenAIHandoff" Content="CREAR ENTREGA PARA IA" IsEnabled="False" ToolTip="Crea/abre un unico ZIP AIIO con todos los casos no soportados actuales. Solo se extraen los archivos exactos en conflicto; nunca se copian PAK fuente completos."/>
                  <Button x:Name="BtnImportManualSolution" Content="Importar solucion IA/manual..." IsEnabled="False" ToolTip="Importa PMM_MANUAL_SOLUTION_V1. Se valida estructuralmente y sigue siendo experimental hasta probarlo en juego."/>
                </WrapPanel>
              </Grid>
            </Expander>

            <Border Grid.Row="5" Margin="0,6,0,0" Padding="8" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="2,0,2,3">
                  <TextBlock Text="Build &amp; Deploy:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <CheckBox x:Name="ChkCloseGame" Content="Cerrar Palworld antes de Deploy" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  <CheckBox x:Name="ChkForceClose" Content="Forzar cierre si expira el cierre normal" VerticalAlignment="Center" Margin="0,0,18,0"/>
                </WrapPanel>
                <TextBlock x:Name="TxtBuildDeployHint" Grid.Row="1" Margin="3,0,3,4" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                <UniformGrid Grid.Row="2" Rows="1" Columns="3">
                  <Button x:Name="BtnBuild" Content="BUILD MERGE" FontWeight="Bold"/>
                  <Button x:Name="BtnDeploy" Content="DEPLOY"/>
                  <Button x:Name="BtnUndeployPatch" Content="UNDEPLOY" IsEnabled="False" ToolTip="Retira solamente el merge seleccionado de ~mods. El build guardado en PMM se conserva."/>
                </UniformGrid>
                <StackPanel Grid.Row="3" Margin="3,5,3,0">
                  <TextBlock x:Name="TxtOperationProgress" Text="Listo. La ultima operacion aparecera aqui." HorizontalAlignment="Center" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="PrgOperation" Height="10" Margin="40,3,40,0" Minimum="0" Maximum="100" Value="0" Visibility="Visible" Foreground="#64748B"/>
                  <TextBlock x:Name="TxtBuildProgress" Text="" Visibility="Collapsed"/>
                  <ProgressBar x:Name="PrgBuild" Height="1" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="TabFixLab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="FIX LAB" VerticalAlignment="Center"/>
            <Border x:Name="BrdFixLabBadge" Background="#D97706" CornerRadius="9" Margin="6,0,0,0" Padding="6,1" Visibility="Collapsed">
              <TextBlock x:Name="TxtFixLabBadge" Text="1" Foreground="White" FontWeight="Bold" FontSize="11"/>
            </Border>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" CanContentScroll="True">
          <Grid Margin="10" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Compact Fix Lab header + Game Reference controls. -->
            <Border Grid.Row="0" Background="{DynamicResource FixHeaderBackground}" BorderBrush="{DynamicResource FixHeaderBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Fix Lab" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource FixHeaderBorder}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="MOTOR DE RECETAS LOCAL" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="Repara mods antiguos compatibles en local usando el PAK fuente, los archivos actuales del juego y recetas compactas reproducibles." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,2,0,0"/>
                  <TextBlock x:Name="TxtFixLabGameReference" Text="Game Reference actual" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" Margin="0,5,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="TxtFixLabGameReferenceProgress" Foreground="{DynamicResource MutedText}" Visibility="Collapsed" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PrgFixLabGameReference" Width="180" Height="7" Margin="8,0,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <Button x:Name="BtnFixLabRefreshDashboard" Content="Actualizar Fix Lab" MinWidth="180" ToolTip="Actualiza el panel de Fix Lab cuando lo pidas. Al cambiar de pestaña se usa la vista en caché para que la navegación sea inmediata."/>
                  <Button x:Name="BtnFixLabBuildReference" Content="Crear / actualizar Game Reference" MinWidth="180"/>
                  <Button x:Name="BtnFixLabOpenReference" Content="Abrir referencia" MinWidth="180" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Notice does not consume a permanent grid slot. -->
            <Border x:Name="BrdFixLabNotice" Grid.Row="1" Background="{DynamicResource NoticeBackground}" BorderBrush="{DynamicResource NoticeBorder}" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center" Margin="1,0,8,0"/>
                <TextBlock x:Name="TxtFixLabNotice" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingAmber}"/>
                <Button x:Name="BtnFixLabDismissNotice" Grid.Column="2" Content="X" ToolTip="Cerrar" Margin="10,0,0,0" Padding="9,2"/>
              </Grid>
            </Border>

            <!-- Six responsive work cards: 2 columns x 3 rows. No minimum widths. -->
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

              <Expander x:Name="ExpFixLabSource" Grid.Row="0" Grid.Column="0" IsExpanded="True" Background="{DynamicResource SourceBackground}" BorderBrush="{DynamicResource SourceBorder}" BorderThickness="1" Padding="9" Margin="0,0,4,8">
                <Expander.Header>
                  <StackPanel Margin="0,1">
                    <TextBlock Text="1. Fuente reparable" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingBlue}"/>
                    <TextBlock x:Name="TxtFixLabCandidateCount" Text="0 candidatos" Foreground="{DynamicResource MutedText}" FontSize="11"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,0">
                  <DockPanel LastChildFill="True">
                    <Button x:Name="BtnFixLabDiscover" DockPanel.Dock="Right" Content="Analizar mods reparables" Margin="8,0,0,5" Padding="10,4"/>
                    <Button x:Name="BtnFixLabIgnoreSource" DockPanel.Dock="Right" Content="Ignorar este mod antiguo" Margin="8,0,0,5" Padding="10,4" ToolTip="Omite Fix Lab para el hash exacto de esta fuente y permite continuar Analyze/AUTO bajo tu responsabilidad."/>
                    <Button x:Name="BtnFixLabDeleteSource" DockPanel.Dock="Right" Content="Borrar este mod" Margin="8,0,0,5" Padding="10,4" ToolTip="Borra el mod fuente de la biblioteca PMM y el PAK exacto de ~mods usando la misma operacion que Imported Mods > Delete."/>
                    <TextBlock Text="Elige el caso de mod antiguo que Fix Lab debe reparar." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,3,0,5"/>
                  </DockPanel>
                  <ListBox x:Name="LstFixLabCandidates" SelectionMode="Single" SelectedValuePath="RecipeId" MinHeight="70" MaxHeight="130">
                    <ListBox.ItemTemplate><DataTemplate>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <RadioButton VerticalAlignment="Center" IsHitTestVisible="False" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceNames}" FontSize="11" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SourceCount}" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Margin="6,0,2,0"/>
                      </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="TxtFixLabCandidate" Margin="0,5,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Text="Solo aparecen mods importados con una receta de Fix Lab documentada." MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Expander>

              <Expander x:Name="ExpFixLabConfigure" Grid.Row="0" Grid.Column="1" IsExpanded="True" Background="{DynamicResource ConfigureBackground}" BorderBrush="{DynamicResource ConfigureBorder}" BorderThickness="1" Padding="9" Margin="4,0,0,8">
                <Expander.Header><StackPanel Margin="0,1"><TextBlock Text="2. Configurar reparación" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingAmber}"/><TextBlock Text="Elige la salida que quieres. PMM nunca elige por ti una variante cosmética o de comportamiento." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,6,0,0">
                  <TextBlock Text="Variante de salida" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <ComboBox x:Name="CmbFixLabVariant" DisplayMemberPath="Label" SelectedValuePath="Id" HorizontalAlignment="Stretch"/>
                  <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ConfigureBorder}" BorderThickness="1" CornerRadius="5" Padding="8"><StackPanel><TextBlock Text="Resumen de receta" FontWeight="SemiBold" Margin="0,0,0,3"/><TextBlock TextWrapping="Wrap"><Run Text="Fuente antigua: "/><Run x:Name="TxtFixLabLegacySource" Text="-"/></TextBlock><TextBlock TextWrapping="Wrap"><Run Text="Módulos de fix: "/><Run x:Name="TxtFixLabModules" Text="-"/></TextBlock><TextBlock TextWrapping="Wrap"><Run Text="Tamaño de salida: "/><Run x:Name="TxtFixLabOutputSize" Text="Pendiente de construir"/></TextBlock></StackPanel></Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ConfigureBorder}" BorderThickness="1" CornerRadius="5" Padding="8"><StackPanel><TextBlock Text="Notas de reparación" FontWeight="SemiBold" Margin="0,0,0,3"/><TextBlock x:Name="TxtFixLabVariantDescription" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" MaxHeight="72"/></StackPanel></Border>
                  </Grid>
                </StackPanel>
              </Expander>

              <Expander x:Name="ExpFixLabBuild" Grid.Row="1" Grid.Column="0" IsExpanded="True" Background="{DynamicResource BuildBackground}" BorderBrush="{DynamicResource BuildBorder}" BorderThickness="1" Padding="9" Margin="0,0,4,8">
                <Expander.Header><StackPanel Margin="0,1"><TextBlock Text="3. Construir y validar" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingPurple}"/><TextBlock Text="Se ejecuta en un proceso de procesamiento separado. Puedes seguir usando PMM mientras construye y valida la reparación." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander.Header>
                <Grid Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel><TextBlock x:Name="TxtFixLabRepairState" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/><TextBlock x:Name="TxtFixLabResult" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" MaxHeight="58"/>
                    <TextBlock x:Name="TxtFixLabRepairProgress" Margin="0,7,0,2" TextWrapping="Wrap" Foreground="{DynamicResource AccentHeadingPurple}" Visibility="Collapsed"/>
