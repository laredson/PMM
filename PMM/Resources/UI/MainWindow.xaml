                <StackPanel Margin="0,6,0,0"><TextBlock Text="Legacy source mods are archived here when Apply Fix commits a repair." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,0,0,4"/><ListBox x:Name="LstFixLabBackups" SelectionMode="Single" MinHeight="68" MaxHeight="120"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CaseId}" FontSize="11" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="8,0,0,0"><TextBlock Text="{Binding SizeMb}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding CreatedDisplay}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="11"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Margin="0,5,0,0"><Button x:Name="BtnFixLabOpenBackupFolder" Content="Open backup folder"/><Button x:Name="BtnFixLabRevertBackup" Content="Restore original mod"/></WrapPanel></StackPanel>
