<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PMM - Palworld Manager Merger v1.2.1"
        Width="1580" Height="940" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" ShowActivated="True"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        FontSize="13">
  <!--
    v1.1.1 UI: the merge engine remains conservative; the contained-superset path returns a proven real cooked provider unchanged.
    The workspace is intentionally resizable and explains the Analyze plan
    asset-by-asset instead of presenting only one summary line.
  -->
  <Window.Resources>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#D5DAE0"/>
    <SolidColorBrush x:Key="MutedText" Color="#5F6B76"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#2E9D50"/>
    <SolidColorBrush x:Key="SoftBlue" Color="#EEF4FF"/>
    <SolidColorBrush x:Key="SoftGreen" Color="#ECF8EF"/>
    <SolidColorBrush x:Key="SoftAmber" Color="#FFF7E6"/>
    <SolidColorBrush x:Key="SoftRed" Color="#FFF0F0"/>
    <SolidColorBrush x:Key="SoftGray" Color="#F7F8FA"/>

    <Style x:Key="DefaultButton" TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="BorderBrush" Value="#AEB6BF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF4FF"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.50"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}"/>

    <Style x:Key="ImportButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#7C3AED"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#6D28D9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#6D28D9"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.50"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#1D4ED8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BuildButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#D97706"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#B45309"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B45309"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.50"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DeployButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#2E9D50"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#258342"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#258342"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="BorderBrush" Value="#C5CBD2"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="PriorityEditorTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Margin" Value="3,1"/>
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="MaxLength" Value="18"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="BorderBrush" Value="#C5CBD2"/>
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DDEBFF"/><Setter Property="Foreground" Value="#152238"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="BorderBrush" Value="#C5CBD2"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E6E9ED"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="BorderBrush" Value="#D5DAE0"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="#DDE2E8"/>
      <Setter Property="ShowsPreview" Value="True"/>
    </Style>
    <Style x:Key="SummaryCard" TargetType="Border">
      <Setter Property="Background" Value="#F7F8FA"/>
      <Setter Property="BorderBrush" Value="#D9DEE4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="12" Background="White" BorderBrush="#CDD3DA" BorderThickness="1" CornerRadius="7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
          <TextBlock Text="PALWORLD MANAGER MERGER" FontSize="20" FontWeight="Bold" Foreground="#17202A"/>
          <TextBlock Text="Palworld mod manager &amp; compatibility merger" Foreground="{StaticResource MutedText}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Palworld installation" FontWeight="SemiBold" Foreground="#34404B"/>
          <TextBox x:Name="TxtGamePath" IsReadOnly="True" Margin="0,4,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
          <Button x:Name="BtnDetectGame" Content="Detect"/>
          <Button x:Name="BtnBrowseGame" Content="Choose Steam..."/>
          <Button x:Name="BtnBrowseGameManual" Content="Choose Palworld..."/>
          <Button x:Name="BtnOpenGame" Content="Open folder"/>
          <Button x:Name="BtnPlay" Content="Start Palworld" Padding="14,5"/>
        </WrapPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="0,10,0,8" Background="White">
      <TabItem Header="Mods &amp; Merge">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColLibrary" Width="470" MinWidth="330"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="650"/>
          </Grid.ColumnDefinitions>

          <!-- Source library. PMM patches are deliberately rendered separately below. -->
          <Border Grid.Column="0" Background="White" BorderBrush="#D5DAE0" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="180"/>
                <RowDefinition Height="6"/>
                <RowDefinition x:Name="RowPatches" Height="145" MinHeight="95" MaxHeight="320"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Mod library" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock x:Name="TxtLibraryCount" Foreground="{StaticResource MutedText}"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                  <Button x:Name="BtnImport" Content="Import..." ToolTip="Import PAK/ZIP/7Z/RAR into the PMM library"/>
                  <Button x:Name="BtnImportGameMods" Content="Import ~mods" ToolTip="Copy the game's current PAKs into the PMM library"/>
                  <Button x:Name="BtnScan" Content="Analyze" Padding="16,5"/>
                </WrapPanel>
              </Grid>

              <Grid Grid.Row="1" Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TxtModFilter" ToolTip="Filter source mods by name or state"/>
                <TextBlock Grid.Column="1" Text="Filter" VerticalAlignment="Center" Margin="8,0,2,0" Foreground="{StaticResource MutedText}"/>
              </Grid>

              <DataGrid x:Name="LstMods" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" AllowDrop="True" HorizontalGridLinesBrush="#EEF1F4" ToolTip="Merge order: drag a row, or type a new number in Order. Top applies earlier; bottom has higher priority. Priority resolves only truly overlapping values; independent changes are preserved.">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value="0.52"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="On" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Enabled source mods participate in Analyze, Build and Deploy"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Order" Width="66" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Priority, Mode=OneWay}" Tag="{Binding Name}" Style="{StaticResource PriorityEditorTextBox}" ToolTip="Type a new merge position. Values below 1 become 1; values above the library size become the last position."/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="MB" Binding="{Binding SizeText}" Width="72" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Hash" Binding="{Binding HashShort}" Width="105" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>

              <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

              <Border Grid.Row="4" BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="5" Background="#FAFBFC" Padding="6">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="1,0,1,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Compatibility patches" FontWeight="SemiBold"/>
                      <TextBlock x:Name="TxtPatchCount" Foreground="{StaticResource MutedText}" FontSize="11.5"/>
                    </StackPanel>
                    <Button x:Name="BtnOpenPatches" Grid.Column="1" Content="Open patch folders" Padding="8,3" MinHeight="26"/>
                  </Grid>
                  <TextBlock Grid.Row="1" Margin="2,0,2,4" FontSize="10.5" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Text="Choose a saved overlay, or No compatibility patch to deploy source mods only. Only patches built from the exact active source hashes + mappings are selectable."/>
                  <DataGrid x:Name="LstPatches" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" FontSize="11" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="Use" Width="42">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><RadioButton GroupName="PMMPatchSelection" IsChecked="{Binding Selected, Mode=OneWay}" IsEnabled="{Binding Selectable}" Tag="{Binding SelectionKey}" ToolTip="{Binding SelectTip}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Patch" Binding="{Binding Name}" Width="*" MinWidth="135" IsReadOnly="True"/>
                      <DataGridTextColumn Header="Decision" Binding="{Binding DecisionSummary}" Width="130" IsReadOnly="True"/>
                      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" IsReadOnly="True"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>

              <WrapPanel Grid.Row="5" Margin="0,7,0,0" HorizontalAlignment="Center">
                <Button x:Name="BtnPriorityUp" Content="Earlier / lower priority" IsEnabled="False" ToolTip="Move this mod upward: its diff is applied earlier"/>
                <Button x:Name="BtnPriorityDown" Content="Later / higher priority" IsEnabled="False" ToolTip="Move this mod downward: it wins truly overlapping values"/>
                <Button x:Name="BtnDeleteMod" Content="Delete from library" IsEnabled="False"/>
              </WrapPanel>
            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

          <!-- Analysis is the dominant workspace. Conflict and unsupported sections collapse when unused. -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="RowAnalysisWorkspace" Height="*"/>
              <RowDefinition x:Name="RowAnalysisConflictSplitter" Height="0"/>
              <RowDefinition x:Name="RowResolutionWorkspace" Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition x:Name="RowWorkspaceFiller" Height="0"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Expander x:Name="ExpAnalysis" Grid.Row="0" Header="Analysis plan" IsExpanded="True" Background="White" BorderBrush="#D5DAE0" BorderThickness="1" Padding="6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtAnalysisHeadline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="3,0,3,5"/>
                <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,5">
                  <Border Style="{StaticResource SummaryCard}" Background="{StaticResource SoftBlue}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtSharedCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Shared assets" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{StaticResource SoftGreen}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtAutoCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Auto merged" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{StaticResource SoftAmber}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtDecisionCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Decisions" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{StaticResource SoftRed}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtUnsupportedCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Unsupported" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="#F3EEFF"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtExperimentalCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Experimental" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtIdenticalCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Identical" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                </UniformGrid>

                <TextBlock x:Name="TxtAnalysisScope" Grid.Row="2" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="3,0,3,6"/>
                <StackPanel Grid.Row="3" Margin="3,0,3,5">
                  <TextBlock x:Name="TxtAnalyzeProgress" Text="" Foreground="{StaticResource MutedText}"/>
                  <ProgressBar x:Name="PrgAnalyze" Height="10" Margin="0,3,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50"/>
                </StackPanel>

                <DataGrid x:Name="DgAnalysisAssets" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" SelectionUnit="FullRow" RowDetailsVisibilityMode="VisibleWhenSelected" EnableRowVirtualization="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="125"/>
                    <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="1.25*"/>
                    <DataGridTextColumn Header="Adapter" Binding="{Binding Adapter}" Width="145"/>
                    <DataGridTextColumn Header="Mods involved" Binding="{Binding Providers}" Width="1.7*"/>
                    <DataGridTextColumn Header="Changes" Binding="{Binding Changes}" Width="105"/>
                  </DataGrid.Columns>
                  <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                      <Border Background="#F7F9FC" BorderBrush="#DEE3E8" BorderThickness="0,1,0,1" Padding="10,7">
                        <StackPanel>
                          <TextBlock Text="{Binding FullAsset}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Details}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#43505C"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </DataGrid.RowDetailsTemplate>
                </DataGrid>
              </Grid>
            </Expander>

            <GridSplitter x:Name="SplAnalysisResolution" Grid.Row="1" Height="6" Margin="0,3,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Visibility="Collapsed"/>

            <Expander x:Name="ExpConflicts" Grid.Row="2" Margin="0,6,0,0" IsExpanded="False" Background="White" BorderBrush="#D5DAE0" BorderThickness="1" Padding="6">
              <Expander.Header><TextBlock x:Name="TxtConflictHeader" Text="Resolution &amp; Review (0)" FontWeight="SemiBold"/></Expander.Header>
              <Grid MinHeight="175" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="ColConflictAssets" Width="250" MinWidth="175"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*" MinWidth="360"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="LstConflictAssets" Grid.Column="0" DisplayMemberPath="Display"/>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
                <Grid Grid.Column="2" Margin="8,0,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock x:Name="TxtConflictMods" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="TxtConflictAsset" Grid.Row="1" Margin="0,3,0,7" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#4A5560"/>
                  <WrapPanel Grid.Row="2" Margin="0,0,0,7" VerticalAlignment="Center">
                    <TextBlock Text="Apply all:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbBulkWinner" Width="190" Margin="0,0,6,0"/>
                    <TextBlock Text="Custom:" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <TextBox x:Name="TxtBulkCustom" Width="110" Margin="0,0,6,0" ToolTip="Used only when Custom is selected"/>
                    <Button x:Name="BtnApplyBulk" Content="Apply to all rows"/>
                    <Button x:Name="BtnOpenReview" Content="Open review files"/>
                  </WrapPanel>
                  <DataGrid x:Name="DgDecisions" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="CellOrRowHeader" IsReadOnly="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
                </Grid>
              </Grid>
            </Expander>

            <Expander x:Name="ExpUnsupported" Grid.Row="3" Header="Blocked shared assets (0)" Margin="0,6,0,0" IsExpanded="False" Background="White" BorderBrush="#D5DAE0" BorderThickness="1" Padding="6">
              <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="LstUnsupportedAssets" Grid.Row="0" MaxHeight="86" DisplayMemberPath="Display"/>
                <TextBox x:Name="TxtUnsupported" Grid.Row="1" Margin="0,5,0,5" MaxHeight="90" MinHeight="42" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FAFBFC"/>
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Disable source:" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <ComboBox x:Name="CmbUnsupportedDisable" Grid.Column="1" Margin="0,0,7,0"/>
                  <Button x:Name="BtnDisableUnsupported" Grid.Column="2" Content="Disable selected mod &amp; Analyze" Style="{StaticResource PrimaryButton}" Padding="10,4"/>
                  <TextBlock x:Name="TxtUnsupportedHint" Grid.Column="3" Text="When an asset is unsupported, PMM can suggest the source whose removal disturbs the fewest other compatible shared merges. This is a structural suggestion, not a gameplay judgement." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="10,0,0,0"/>
                </Grid>
                <WrapPanel Grid.Row="3" Margin="0,5,0,0">
                  <Button x:Name="BtnOpenAIHandoff" Content="CREATE AI HANDOFF" IsEnabled="False" ToolTip="Create/open one AIIO ZIP for all current Unsupported cases. Only exact conflicting files are extracted; whole source PAKs are never copied."/>
                  <Button x:Name="BtnImportManualSolution" Content="Import AI/manual solution..." IsEnabled="False" ToolTip="Import PMM_MANUAL_SOLUTION_V1. PMM validates structure/provenance, but it remains experimental until tested in game."/>
                </WrapPanel>
              </Grid>
            </Expander>

            <Border Grid.Row="5" Margin="0,6,0,0" Padding="8" Background="White" BorderBrush="#D5DAE0" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="2,0,2,3">
                  <TextBlock Text="Build &amp; Deploy:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <CheckBox x:Name="ChkCloseGame" Content="Close Palworld before Deploy" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  <CheckBox x:Name="ChkForceClose" Content="Force close if graceful shutdown times out" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock x:Name="TxtBuildDeployHint" Grid.Row="1" Margin="3,0,3,4" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"/>
                <UniformGrid Grid.Row="2" Rows="1" Columns="3">
                  <Button x:Name="BtnBuild" Content="BUILD MERGE" FontWeight="Bold"/>
                  <Button x:Name="BtnDeploy" Content="DEPLOY"/>
                  <Button x:Name="BtnRestore" Content="Restore / remove PMM merges"/>
                </UniformGrid>
                <StackPanel Grid.Row="3" Margin="3,4,3,0">
                  <TextBlock x:Name="TxtBuildProgress" Text="" HorizontalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                  <ProgressBar x:Name="PrgBuild" Height="11" Margin="70,3,70,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Saves">
        <Grid Margin="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" MinWidth="300"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
          </Grid.ColumnDefinitions>
          <GroupBox Header="Worlds &amp; backups">
            <ListBox x:Name="LstSaves" DisplayMemberPath="Display"/>
          </GroupBox>
          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
          <GroupBox Grid.Column="2" Header="Selected save">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBox x:Name="TxtSaveDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="BtnBackupSave" Content="Create backup" Padding="16,7"/>
                <Button x:Name="BtnRestoreSave" Content="Restore backup" Padding="16,7"/>
              </StackPanel>
            </Grid>
          </GroupBox>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Interface" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Language and workspace layout" Foreground="{StaticResource MutedText}" Margin="0,2,0,7"/>
            <WrapPanel Margin="0,0,0,8">
              <ComboBox x:Name="CmbLanguage" Width="180" DisplayMemberPath="Label" SelectedValuePath="Code"/>
              <Button x:Name="BtnApplyLanguage" Content="Apply language"/>
              <Button x:Name="BtnResetLayout" Content="Reset workspace layout" ToolTip="Reset window size and the draggable panel dividers"/>
            </WrapPanel>

            <Separator Margin="0,8"/>
            <TextBlock Text="Portable library" FontSize="16" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtLibraryPath" IsReadOnly="True" Margin="0,5" MinWidth="700"/>
            <Button x:Name="BtnOpenLibrary" Content="Open library" HorizontalAlignment="Left"/>

            <Separator Margin="0,12"/>
            <TextBlock Text="Vanilla Game Reference" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Builds an optional local reusable research reference from your own Pal-Windows.pak. AIIO does not require or copy this broad cache into normal handoffs; the public app does not ship extracted game assets." TextWrapping="Wrap" Margin="0,3,0,4" Foreground="{StaticResource MutedText}"/>
            <TextBlock x:Name="TxtGameReferenceSummary" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{StaticResource MutedText}"/>
            <WrapPanel>
              <Button x:Name="BtnBuildGameReference" Content="Build / refresh Game Reference" ToolTip="Runs in the background and bulk-extracts the reusable PMM research scope from Pal-Windows.pak. Read-only with respect to Palworld."/>
              <Button x:Name="BtnOpenGameReference" Content="Open Game Reference folder"/>
            </WrapPanel>
            <TextBlock x:Name="TxtGameReferenceProgress" Margin="0,7,0,2" Foreground="{StaticResource MutedText}" Visibility="Collapsed" TextWrapping="Wrap"/>
            <ProgressBar x:Name="PrgGameReference" Height="10" Width="700" HorizontalAlignment="Left" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50"/>

            <Separator Margin="0,12"/>
            <TextBlock Text="Merge knowledge &amp; community handoff" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtKnowledgeSummary" TextWrapping="Wrap" Margin="0,4,0,6" Foreground="{StaticResource MutedText}"/>
            <WrapPanel>
              <Button x:Name="BtnOpenKnowledge" Content="Open Knowledge library"/>
              <Button x:Name="BtnOpenReviewCases" Content="Open AI review cases" ToolTip="Open Analyze review metadata. AI handoff ZIPs are created separately, on request, as one bundle for the current Unsupported set."/>
              <Button x:Name="BtnExportKnowledgeContribution" Content="Create tested contribution..." ToolTip="After an imported AI/manual solution has passed an in-game test, package the original handoff + solution + runtime PASS for community/maintainer review."/>
              <Button x:Name="BtnOpenKnowledgeContributions" Content="Open contribution folder"/>
            </WrapPanel>

            <Separator Margin="0,12"/>
            <TextBlock Text="Dependencies" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Start checks dependencies automatically and prepares/downloads only what is missing. This button forces a manual repair." TextWrapping="Wrap" Margin="0,4,0,6" Foreground="{StaticResource MutedText}"/>
            <Button x:Name="BtnSetupDeps" Content="Prepare / repair dependencies" HorizontalAlignment="Left"/>

            <Separator Margin="0,12"/>
            <TextBlock Text="Recent log — support file: Workspace\Logs\PalModMerger.log" FontSize="16" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtLog" Height="280" MinWidth="850" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#E9EDF2" CornerRadius="4" Padding="7,4">
      <TextBlock x:Name="TxtStatus" Foreground="#394550"/>
    </Border>
  </Grid>
</Window>
