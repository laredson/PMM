        </Grid>
      </TabItem>
      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Margin="14" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Interface" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Language and workspace layout" Foreground="{DynamicResource MutedText}" Margin="0,2,0,7"/>
                <WrapPanel>
                  <ComboBox x:Name="CmbLanguage" Width="180" DisplayMemberPath="Label" SelectedValuePath="Code"/>
                  <Button x:Name="BtnApplyLanguage" Content="Apply language"/>
                  <Button x:Name="BtnResetLayout" Content="Reset workspace layout" ToolTip="Reset window size and the draggable panel dividers"/>
                  <TextBlock Text="Action hint:" VerticalAlignment="Center" Margin="14,0,5,0"/>
                  <ComboBox x:Name="CmbActionHintDuration" Width="220" DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="0 disables the bubble; 1-120 seconds; Infinite stays until closed with ×."/>
                </WrapPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20,0,0,0">
                <Button x:Name="BtnRestoreDefaults" Content="Restore defaults" MinWidth="130" ToolTip="Restore interface, ColorFlow hint and audio defaults. Language, paths, library and user data are not changed."/>
                <Button x:Name="BtnApplySettings" Content="Apply changes" MinWidth="130" FontWeight="SemiBold" ToolTip="Apply theme, ColorFlow hint duration and completion sound without restarting PMM."/>
              </StackPanel>
            </Grid>
            <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,4,0,8">
              <StackPanel>
                <TextBlock Text="Color scheme" FontSize="15.5" FontWeight="SemiBold"/>
                <TextBlock Text="Choose a scheme and press Apply changes. PMM Crystal is the fresh-install default. User JSON schemes can override the full palette and optionally the ColorFlow colors." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                <TextBlock Text="Official PMM schemes" FontWeight="SemiBold" Margin="0,2,0,1"/>
                <WrapPanel x:Name="PnlThemeOptions" Margin="0,1,0,5"/>
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,1,0,6"><StackPanel><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="Added user schemes" FontWeight="SemiBold"/><TextBlock x:Name="TxtThemeInfo" Margin="12,0,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/></DockPanel><TextBlock x:Name="TxtUserThemeEmpty" Text="No user schemes installed." Foreground="{DynamicResource MutedText}" Margin="0,5,0,0"/><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="PnlUserThemeOptions" Margin="0,5,0,0"/></ScrollViewer></StackPanel></Border>
                <WrapPanel><Button x:Name="BtnImportTheme" Content="Add scheme..." ToolTip="Install reusable user schemes from JSON or ZIP."/><Button x:Name="BtnOpenThemesFolder" Content="Open schemes folder"/></WrapPanel>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Sound events" FontSize="15.5" FontWeight="SemiBold"/>
                <TextBlock Text="Configure each notification separately. Built-in sounds stay on the top row; sounds you add appear in the custom list below." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                <WrapPanel Margin="0,0,0,7" VerticalAlignment="Center">
                  <TextBlock Text="Configure:" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <ComboBox x:Name="CmbSoundEventProfile" Width="285"/>
                  <CheckBox x:Name="ChkSoundEachAutoStep" Content="Sound each AUTO step" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="Play the Semiauto sound after every completed step while AUTO/Auto ON is running. Enabled by default; choose None or clear this option to mute it."/>
                  <CheckBox x:Name="ChkSoundAttention" Content="Sound when attention is required" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </WrapPanel>
                <TextBlock x:Name="TxtSoundEventDescription" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                <TextBlock Text="Built-in sounds" FontWeight="SemiBold" Margin="0,1,0,3"/>
                <WrapPanel Margin="0,0,0,6">
                  <RadioButton x:Name="RdoSoundNone" GroupName="PMMBuiltinSound" Tag="None" Content="No sound" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundBell" GroupName="PMMBuiltinSound" Tag="Bell" Content="Bell" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundMicrowave" GroupName="PMMBuiltinSound" Tag="Microwave" Content="Microwave finish" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundMicrowave3" GroupName="PMMBuiltinSound" Tag="Microwave3" Content="3 beeps" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundOk" GroupName="PMMBuiltinSound" Tag="Ok" Content="OK" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundGood" GroupName="PMMBuiltinSound" Tag="Good" Content="Good" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundCrystal" GroupName="PMMBuiltinSound" Tag="Crystal" Content="Crystal chime" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundAlert" GroupName="PMMBuiltinSound" Tag="Alert" Content="Short alert" Margin="0,2,14,2"/>
                  <RadioButton x:Name="RdoSoundCustom" GroupName="PMMBuiltinSound" Content="Choose custom" Margin="0,2,14,2"/>
                </WrapPanel>
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,1,0,6">
                  <StackPanel>
                    <DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="Added custom sounds" FontWeight="SemiBold"/><TextBlock x:Name="TxtSoundInfo" Margin="12,0,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/></DockPanel>
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="PnlCustomSoundOptions" Margin="0,5,0,0"/></ScrollViewer>
                  </StackPanel>
                </Border>
                <WrapPanel><Button x:Name="BtnImportSound" Content="Add sound..."/><Button x:Name="BtnOpenSoundsFolder" Content="Open sounds folder"/><Button x:Name="BtnTestCompletionSound" Content="Test sound"/></WrapPanel>
                <WrapPanel Margin="0,7,0,0" VerticalAlignment="Center"><TextBlock Text="Volume:" VerticalAlignment="Center" Margin="0,0,7,0"/><Slider x:Name="SldCompletionVolume" Width="300" Minimum="0" Maximum="100" Value="50" TickFrequency="10" VerticalAlignment="Center"/><TextBlock x:Name="TxtCompletionVolume" Text="50%" Width="48" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></WrapPanel>
              </StackPanel>
            </Border>

            <Separator Margin="0,8"/>
            <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="11">
              <StackPanel>
                <TextBlock Text="Palworld installation" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Automatic detection is recommended. Manual Steam and Palworld selectors are available here for unusual installations." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                <TextBox x:Name="TxtGamePath" IsReadOnly="True" Margin="0,0,0,6"/>
                <WrapPanel>
                  <Button x:Name="BtnDetectGameSettings" Content="Detect automatically"/>
                  <Button x:Name="BtnBrowseGame" Content="Choose Steam folder..."/>
                  <Button x:Name="BtnBrowseGameManual" Content="Choose Palworld folder..."/>
                  <Button x:Name="BtnOpenGameSettings" Content="Open game folder"/>
                  <Button x:Name="BtnOpenModsSettings" Content="Open mods folder"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Separator Margin="0,8"/>
            <TextBlock Text="Portable library" FontSize="16" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtLibraryPath" IsReadOnly="True" Margin="0,5" HorizontalAlignment="Stretch"/>
            <Button x:Name="BtnOpenLibrary" Content="Open library" HorizontalAlignment="Left"/>

            <Separator Margin="0,12"/>
            <TextBlock Text="Dependencies" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Start checks dependencies automatically and prepares/downloads only what is missing. This button forces a manual repair." TextWrapping="Wrap" Margin="0,4,0,6" Foreground="{DynamicResource MutedText}"/>
            <Button x:Name="BtnSetupDeps" Content="Prepare / repair dependencies" HorizontalAlignment="Left"/>

            <Separator Margin="0,12"/>
            <TextBlock Text="Recent log — support file: Workspace\Logs\PalModMerger.log" FontSize="16" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtLog" Height="280" HorizontalAlignment="Stretch" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="{DynamicResource StatusBackground}" CornerRadius="4" Padding="7,4">
      <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource PrimaryText}"/>
    </Border>
  </Grid>
</Window>
