                <ComboBox x:Name="CmbFixLabJob"/><Button x:Name="BtnFixLabRefreshJobs"/><Button x:Name="BtnFixLabOpenJob"/>
                <ListBox x:Name="LstFixLabPrimaryMods"/><Button x:Name="BtnFixLabUseLibraryMod"/><Button x:Name="BtnFixLabBrowsePrimary"/><TextBlock x:Name="TxtFixLabPrimary"/>
                <ListBox x:Name="LstFixLabRelated"/><Button x:Name="BtnFixLabAddRelated"/><Button x:Name="BtnFixLabRemoveRelated"/>
                <Button x:Name="BtnFixLabAnalyze"/><TextBlock x:Name="TxtFixLabAnalysis"/><DataGrid x:Name="DgFixLabPakInventory"/><ComboBox x:Name="CmbFixLabRecipe"/>
                <TextBlock x:Name="TxtFixLabBuildState"/><Button x:Name="BtnFixLabBuild"/><Button x:Name="BtnFixLabRebuild"/><Button x:Name="BtnFixLabAddOutputToLibrary"/>
              </StackPanel></Grid>
            </Grid>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="TabAIHelp">
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="AI &amp; Help"/><Border x:Name="BrdAIHelpBadge" Background="{DynamicResource NoticeBorder}" CornerRadius="8" Margin="6,0,0,0" Padding="5,0" Visibility="Collapsed"><TextBlock x:Name="TxtAIHelpBadge" Text="0" Foreground="White" FontSize="10" FontWeight="Bold"/></Border></StackPanel></TabItem.Header>
        <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="3,0,3,8"><TextBlock Text="AI &amp; Help" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Solve problems, prepare a task for an external AI, or create something with PMM. AIIO is local-first: nothing is uploaded and returned files are staged as untrusted data." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/></StackPanel>
          <TabControl x:Name="AIHelpTabs" Grid.Row="1">
            <TabItem Header="Help">
              <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Record what went wrong and collect bounded local evidence. This section does not ask an AI or change mods." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="2,0,2,8"/>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="280"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.25*" MinWidth="360"/></Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Current attention and diagnostic cases" FontWeight="SemiBold" FontSize="15"/><ListBox x:Name="LstAIHelpDiagnostics" Grid.Row="1" DisplayMemberPath="Display" Margin="0,7"/><WrapPanel Grid.Row="2"><Button x:Name="BtnAIHelpRefresh" Content="Refresh"/><Button x:Name="BtnAIHelpPrepareDiagnostic" Content="Prepare selected for AI"/></WrapPanel></Grid></Border>
                  <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
                  <Border Grid.Column="2" Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="Describe the problem" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="A selected mod or build is a suspicion, not a confirmed cause. PMM stores bounded metadata and sanitized evidence only." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/><ComboBox x:Name="CmbAIHelpDiagnosticType" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBox x:Name="TxtAIHelpDiagnosticTitle" Margin="0,6,0,0" ToolTip="Short title"/><TextBox x:Name="TxtAIHelpDiagnosticDescription" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" ToolTip="What happened, what you expected and how to reproduce it"/><CheckBox x:Name="ChkAIHelpIncludePalLog" Content="Include a bounded sanitized Palworld log summary" Margin="0,7,0,2"/><Button x:Name="BtnAIHelpCreateCase" Content="Create diagnostic case" HorizontalAlignment="Left"/><TextBlock x:Name="TxtAIHelpDiagnosticStatus" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="AI repair">
              <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Use this after a diagnostic or Unsupported conflict needs external reasoning. PMM creates and imports manual ZIPs; returned data stays inactive until you approve it." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="2,0,2,8"/>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.2*" MinWidth="380"/></Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Active sessions" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Sessions survive restarts and keep every request, response, candidate and decision together." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/></StackPanel><ListBox x:Name="LstAIIOSessions" Grid.Row="1" DisplayMemberPath="Display" MinHeight="70" Margin="0,7"/><TextBlock Grid.Row="2" Text="Staged candidates" FontWeight="SemiBold" Margin="0,3,0,3"/><ListBox x:Name="LstAIIOCandidates" Grid.Row="3" DisplayMemberPath="Display" MinHeight="55"/><TextBlock x:Name="TxtAIIOCandidateStatus" Grid.Row="4" Text="Returned content is untrusted and inactive until explicitly accepted." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,4"/><WrapPanel Grid.Row="5"><Button x:Name="BtnAIIOOpenWorkspace" Content="Open AI workspace"/><Button x:Name="BtnAIIOArchive" Content="Archive session"/><Button x:Name="BtnAIIOOpenCandidate" Content="Inspect candidate"/><Button x:Name="BtnAIIOUseCandidate" Content="Use candidate in Merge..." IsEnabled="False" FontWeight="SemiBold"/></WrapPanel></Grid></Border>
                  <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
                  <Border Grid.Column="2" Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="Prepare a task for an AI" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="PMM creates a safe ZIP. Give it to the AI yourself, then import its response ZIP here. PMM never executes returned code or deploys a returned PAK automatically." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/><ComboBox x:Name="CmbAIIOType" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBox x:Name="TxtAIIOTitle" Margin="0,6,0,0" ToolTip="Task title"/><TextBox x:Name="TxtAIIODescription" Height="115" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" ToolTip="What you want the AI to investigate, repair, create or change"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="0.42*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="CmbAIOTargetKind" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBox x:Name="TxtAIOTargetId" Grid.Column="2" ToolTip="Optional selected mod, build, save, Fix Lab result or error ID"/></Grid><WrapPanel Margin="0,7,0,0"><Button x:Name="BtnAIIONewSession" Content="Create session"/><Button x:Name="BtnAIIOPrepare" Content="Prepare for AI" FontWeight="SemiBold"/><Button x:Name="BtnAIIOImportResponse" Content="Import AI response..."/><Button x:Name="BtnAIIOContinue" Content="Prepare requested data"/></WrapPanel><TextBlock x:Name="TxtAIIOStatus" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="Feedback">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12" MaxWidth="1100">
                <TextBlock Text="Create inspectable files for manual sharing. Nothing is uploaded in this release; the disabled upload control marks the future connection point." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="2,0,2,8"/>
                <Border Style="{StaticResource SummaryCard}"><StackPanel>
                  <TextBlock Text="Comment or report" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="Feedback type" FontWeight="SemiBold" Margin="0,7,0,3"/>
                  <ComboBox x:Name="CmbAIHelpFeedbackType" DisplayMemberPath="Label" SelectedValuePath="Id"/>
                  <TextBlock Text="Title" FontWeight="SemiBold" Margin="0,7,0,3"/>
                  <TextBox x:Name="TxtAIHelpFeedbackTitle" ToolTip="Short title (optional if comments are provided)"/>
                  <TextBlock Text="Comments" FontWeight="SemiBold" Margin="0,7,0,3"/>
                  <TextBox x:Name="TxtAIHelpFeedbackComments" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Comments, expected behavior, reproduction notes or Knowledge/CKL context"/>
                  <TextBlock Text="Optional exact merge context" FontWeight="SemiBold" Margin="0,8,0,3"/>
                  <ComboBox x:Name="CmbAIHelpFeedbackBuild" DisplayMemberPath="Display"/>
                  <WrapPanel Margin="0,7,0,0"><Button x:Name="BtnAIHelpCreateFeedback" Content="Create share file..." FontWeight="SemiBold"/><Button x:Name="BtnAIHelpOpenFeedback" Content="Open feedback folder"/><Button x:Name="BtnAIHelpUploadFeedback" Content="Upload (not connected)" IsEnabled="False"/></WrapPanel>
                  <TextBlock x:Name="TxtAIHelpFeedbackStatus" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="3,8,3,3"><StackPanel><TextBlock Text="Exact merge validation" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Exports the latest local PASS, PARTIAL or FAIL event for the selected deterministic build. Ordinary validation does not create a main AI &amp; Help alert." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,7"/><Button x:Name="BtnAIHelpGenerateFeedback" Content="Create exact validation feedback" HorizontalAlignment="Left"/></StackPanel></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="3,8,3,3"><StackPanel><TextBlock Text="Knowledge / CKL contribution" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="After an imported solution has been tested in Palworld, package its handoff, candidate and exact runtime evidence for manual maintainer/community review." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,7"/><WrapPanel><Button x:Name="BtnExportKnowledgeContribution" Content="Create tested contribution..."/><Button x:Name="BtnOpenKnowledgeContributions" Content="Open contribution folder"/></WrapPanel></StackPanel></Border>
              </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Knowledge"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" MaxWidth="1100"><Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="Local Knowledge" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="TxtAIHelpKnowledgeSummary" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,3,0,0"/><WrapPanel Margin="0,7,0,0"><Button x:Name="BtnAIHelpOpenKnowledge" Content="Open Knowledge library"/><Button x:Name="BtnOpenReviewCases" Content="Open AI review cases"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource SummaryCard}" Margin="3,8,3,3"><StackPanel><TextBlock Text="Storage and recoverability" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="TxtAIHelpStorageSummary" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,3,0,0"/><TextBlock Text="Interrupted operations" FontWeight="SemiBold" Margin="0,8,0,3"/><ListBox x:Name="LstAIHelpInterrupted" DisplayMemberPath="Display" MinHeight="60" MaxHeight="150"/><WrapPanel Margin="0,7,0,0"><Button x:Name="BtnAIHelpRefreshKnowledge" Content="Refresh"/><Button x:Name="BtnAIHelpCleanup" Content="Review disposable cleanup"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Color scheme editor"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="430"/></Grid.ColumnDefinitions>
              <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Create or continue" FontSize="15" FontWeight="SemiBold"/><ComboBox x:Name="CmbThemeEditorSource" Grid.Row="1" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,7,0,0"/><Button x:Name="BtnThemeEditorNew" Grid.Row="2" Content="Create new from selected" Margin="0,5,0,7"/><ListBox x:Name="LstThemeDrafts" Grid.Row="3" DisplayMemberPath="Display"/><WrapPanel Grid.Row="4" Margin="0,7,0,0"><Button x:Name="BtnThemeEditorLoad" Content="Load draft"/><Button x:Name="BtnThemeEditorDelete" Content="Delete draft"/></WrapPanel></Grid></Border>
              <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
              <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4"><TextBlock Text="Color scheme editor" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Every named brush keeps a required fallback color and may use a packaged PNG/JPEG image. Images are copied into the draft; external paths and URLs are forbidden." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBox x:Name="TxtThemeEditorName" ToolTip="Scheme name"/><TextBox x:Name="TxtThemeEditorId" Grid.Column="2" ToolTip="Lowercase scheme ID"/><ComboBox x:Name="CmbThemeEditorBase" Grid.Column="4"/></Grid><Border x:Name="BrdThemeEditorPreview" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,8,0,8"><StackPanel><TextBlock Text="Live preview uses the current whole-window theme after Preview. Save or install only when validation passes." TextWrapping="Wrap"/><WrapPanel Margin="0,6,0,0"><Button Content="Normal button" IsHitTestVisible="False"/><Button Content="Disabled button" IsEnabled="False"/><TextBox Width="180" Text="Input / selected colors" IsReadOnly="True"/></WrapPanel></StackPanel></Border><StackPanel x:Name="PnlThemeEditorRows"/><TextBlock Text="Create with AI (offline ZIP)" FontWeight="SemiBold" Margin="0,10,0,3"/><TextBox x:Name="TxtThemeEditorPrompt" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Describe the visual direction for an external AI"/><WrapPanel Margin="0,7,0,0"><Button x:Name="BtnThemeEditorSave" Content="Save draft"/><Button x:Name="BtnThemeEditorPreview" Content="Preview"/><Button x:Name="BtnThemeEditorRevert" Content="Revert preview"/><Button x:Name="BtnThemeEditorInstall" Content="Install locally" FontWeight="SemiBold"/><Button x:Name="BtnThemeEditorExport" Content="Export JSON/ZIP"/><Button x:Name="BtnThemeEditorCreateAI" Content="Create with AI"/><Button x:Name="BtnThemeEditorImportAI" Content="Import AI theme..."/></WrapPanel><TextBlock x:Name="TxtThemeEditorStatus" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></ScrollViewer>
            </Grid></TabItem>
            <TabItem Header="Settings">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12" MaxWidth="1100">
                <TextBlock Text="Choose how the local AI &amp; Help module records failures and prepares optional reference data. No provider or upload connection is configured here." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="2,0,2,8"/>
                <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="Diagnostics behavior" FontSize="15" FontWeight="SemiBold"/><CheckBox x:Name="ChkAIIOAutoCreateErrorCases" Content="Create or reuse a diagnostic case when a real PMM operation fails" Margin="0,7,0,0"/><TextBlock Text="Identical repeated failures reuse one open case. Normal validation and Waiting for AI sessions never create a main-tab alert." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock x:Name="TxtAIIOSettingsStatus" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="3,8,3,3"><StackPanel><TextBlock Text="Vanilla Game Reference" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Optional reusable research reference built locally from your own Pal-Windows.pak. It is not copied into normal AIIO handoffs and does not modify Palworld." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,4"/><TextBlock x:Name="TxtGameReferenceSummary" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{DynamicResource MutedText}"/><WrapPanel><Button x:Name="BtnBuildGameReference" Content="Build / refresh Game Reference"/><Button x:Name="BtnOpenGameReference" Content="Open Game Reference folder"/></WrapPanel><TextBlock x:Name="TxtGameReferenceProgress" Margin="0,7,0,2" Foreground="{DynamicResource MutedText}" Visibility="Collapsed" TextWrapping="Wrap"/><ProgressBar x:Name="PrgGameReference" Height="10" HorizontalAlignment="Stretch" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50"/></StackPanel></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="3,8,3,3"><StackPanel><TextBlock Text="Knowledge runtime state" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="TxtKnowledgeSummary" TextWrapping="Wrap" Margin="0,4,0,6" Foreground="{DynamicResource MutedText}"/><Button x:Name="BtnOpenKnowledge" Content="Open Knowledge library" HorizontalAlignment="Left"/></StackPanel></Border>
              </StackPanel></ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>
      <TabItem Header="Saves">
        <Grid Margin="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" MinWidth="360"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="430"/></Grid.ColumnDefinitions>
          <GroupBox Header="Worlds"><ListBox x:Name="LstSaves" DisplayMemberPath="Display"/></GroupBox>
          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition x:Name="RowSelectedSave" Height="*" MinHeight="36"/><RowDefinition x:Name="RowSavePaneSplitter" Height="6"/><RowDefinition x:Name="RowSaveBackups" Height="*" MinHeight="36"/></Grid.RowDefinitions>
