            <Expander x:Name="ExpSaveBackups" Grid.Row="2" Header="PMM backups made (0)" IsExpanded="True" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="8">
