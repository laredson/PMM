              <Expander x:Name="ExpFixLabAdvanced" Grid.Row="2" Grid.Column="1" IsExpanded="False" Background="{DynamicResource AdvancedBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="9" Margin="4,0,0,0">
                <Expander.Header><StackPanel Margin="0,1"><TextBlock Text="6. Advanced / AI repair handoff" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}"/><TextBlock Text="Diagnostics, local workshop files, and handoff tools for unsupported repair cases." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,6,0,0"><TextBlock x:Name="TxtFixLabIgnoredCount" Text="0 ignored sources" Foreground="{DynamicResource MutedText}" Margin="0,0,0,4"/><WrapPanel><Button x:Name="BtnFixLabCreateHandoff" Content="Create repair handoff..."/><Button x:Name="BtnFixLabOpenOutput" Content="Open current job output"/><Button x:Name="BtnFixLabOpenRoot" Content="Open Fix Lab folder"/><Button x:Name="BtnFixLabClearIgnored" Content="Clear ignored repairs"/></WrapPanel></StackPanel>
              </Expander>

