<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PMM - Palworld Manager Merger v1.3.0"
        Width="1460" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" ShowActivated="True"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI"
        FontSize="13">
  <!--
    v1.1.1 UI: the merge engine remains conservative; the contained-superset path returns a proven real cooked provider unchanged.
    The workspace is intentionally resizable and explains the Analyze plan
    asset-by-asset instead of presenting only one summary line.
  -->
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#EAF0F7"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#F8FBFF"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardAltBackground" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#D5DAE0"/>
    <SolidColorBrush x:Key="InputBorder" Color="#C5CBD2"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#17202A"/>
    <SolidColorBrush x:Key="MutedText" Color="#5F6B76"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#DDEBFF"/>
    <SolidColorBrush x:Key="SelectionText" Color="#152238"/>
    <SolidColorBrush x:Key="GridLine" Color="#E6E9ED"/>
    <SolidColorBrush x:Key="Splitter" Color="#DDE2E8"/>
    <SolidColorBrush x:Key="StatusBackground" Color="#E9EDF2"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#2E9D50"/>
    <SolidColorBrush x:Key="SoftBlue" Color="#EEF4FF"/>
    <SolidColorBrush x:Key="SoftGreen" Color="#ECF8EF"/>
    <SolidColorBrush x:Key="SoftAmber" Color="#FFF7E6"/>
    <SolidColorBrush x:Key="SoftRed" Color="#FFF0F0"/>
    <SolidColorBrush x:Key="SoftGray" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="FixHeaderBackground" Color="#EEF3F8"/>
    <SolidColorBrush x:Key="FixHeaderBorder" Color="#C9D5E2"/>
    <SolidColorBrush x:Key="NoticeBackground" Color="#FFF7ED"/>
    <SolidColorBrush x:Key="NoticeBorder" Color="#F2B56B"/>
    <SolidColorBrush x:Key="SourceBackground" Color="#F4F8FF"/>
    <SolidColorBrush x:Key="SourceBorder" Color="#CAD8EA"/>
    <SolidColorBrush x:Key="ConfigureBackground" Color="#FFF9EE"/>
    <SolidColorBrush x:Key="ConfigureBorder" Color="#E8D6AE"/>
    <SolidColorBrush x:Key="BuildBackground" Color="#F7F5FF"/>
    <SolidColorBrush x:Key="BuildBorder" Color="#D8D1EF"/>
    <SolidColorBrush x:Key="OutputBackground" Color="#F1FAF3"/>
    <SolidColorBrush x:Key="OutputBorder" Color="#C8E2CE"/>
    <SolidColorBrush x:Key="BackupBackground" Color="#FAF8F5"/>
    <SolidColorBrush x:Key="BackupBorder" Color="#DDD7CF"/>
    <SolidColorBrush x:Key="AdvancedBackground" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="AccentHeadingBlue" Color="#284B73"/>
    <SolidColorBrush x:Key="AccentHeadingAmber" Color="#7A551A"/>
    <SolidColorBrush x:Key="AccentHeadingPurple" Color="#51427C"/>
    <SolidColorBrush x:Key="AccentHeadingGreen" Color="#2F6B3B"/>
    <SolidColorBrush x:Key="WarmHeading" Color="#62584C"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#111827"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#CBD5E1"/>

    <Style x:Key="DefaultButton" TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}"/>

    <Style x:Key="ImportButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#7C3AED"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#6D28D9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#6D28D9"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#1D4ED8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BuildButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#D97706"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#B45309"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B45309"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DeployButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#2E9D50"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#258342"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#258342"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
      <Setter Property="Background" Value="#0F9D8A"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0F766E"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0F766E"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0" Margin="7,2,3,2" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                  <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="360">
                  <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PriorityEditorTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Margin" Value="3,1"/>
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="MaxLength" Value="18"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Margin="0,0,2,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderBrush" Value="{DynamicResource GridLine}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Background" Value="{DynamicResource CardBorder}"/>
    </Style>
    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource Splitter}"/>
      <Setter Property="ShowsPreview" Value="True"/>
    </Style>
    <Style x:Key="SummaryCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10">
      <Grid x:Name="GrdHeaderLayout">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="4,0,22,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image x:Name="ImgPMMLogo" Grid.Column="0" Width="148" Height="148" Stretch="Uniform" Margin="0,0,20,0" SnapsToDevicePixels="True"/>
          <StackPanel x:Name="PnlHeaderTitle" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="PALWORLD" FontFamily="Bahnschrift SemiBold" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" LineHeight="33"/>
            <TextBlock Text="MANAGER" FontFamily="Bahnschrift SemiBold" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" LineHeight="33"/>
            <TextBlock Text="MERGER" FontFamily="Bahnschrift SemiBold" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" LineHeight="33"/>
            <TextBlock Text="Palworld mod manager &amp; compatibility merger" Foreground="{DynamicResource MutedText}" FontSize="14" Margin="1,5,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="GrdHeaderActions" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Button x:Name="BtnDetectGame" Grid.Row="0" HorizontalAlignment="Stretch" MinWidth="0" Padding="12,7" Margin="0,0,0,6" ToolTip="Detect Palworld automatically. If automatic detection fails, PMM asks you to select a Steam or Palworld folder.">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}">
                <Setter Property="Background" Value="{DynamicResource CardAltBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                <Setter Property="Opacity" Value="1"/>
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="1"/></Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel>
              <TextBlock x:Name="TxtGamePathStatus" Text="Palworld not detected - click to detect" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="Detect automatically, or configure the installation from Settings." Foreground="{DynamicResource MutedText}" FontSize="11.5" TextAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
          </Button>
          <Border Grid.Row="2" Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" Padding="8,4">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <WrapPanel VerticalAlignment="Center"><CheckBox x:Name="TglAutoMode" Content="Auto ON" VerticalAlignment="Center" Margin="2,0,12,0" ToolTip="When enabled, a workflow action you start manually continues automatically through all remaining safe steps."/><CheckBox x:Name="ChkAutoPlay" Content="Run Palworld after Deploy" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Launch Palworld after the final successful Deploy in an automatic run."/></WrapPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnAutoRun" Content="AUTO" Style="{StaticResource DefaultButton}" MinWidth="82" FontWeight="Bold" ToolTip="Run all remaining safe steps once from the current state without enabling Auto ON."/><Button x:Name="BtnCancelOperation" Content="CANCEL" MinWidth="92" IsEnabled="False" ToolTip="Cancel the current operation or automatic workflow. Deploy rolls back if commit already started."/></StackPanel>
            </Grid>
          </Border>
          <UniformGrid Grid.Row="1" Columns="3" HorizontalAlignment="Stretch" Margin="0,0,0,6"><Button x:Name="BtnOpenGame" Content="Open game folder"/><Button x:Name="BtnOpenModsFolder" Content="Open mods folder"/><Button x:Name="BtnPlay" Content="Start Palworld" Padding="16,6"/></UniformGrid>
        </Grid>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,10,0,8" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource PrimaryText}">
      <TabItem Header="Mods &amp; Merge">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColLibrary" Width="2*" MinWidth="290" MaxWidth="520"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition x:Name="ColAnalysisWorkspace" Width="3*" MinWidth="460"/>
          </Grid.ColumnDefinitions>

          <!-- Source library. PMM patches are deliberately rendered separately below. -->
          <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="6"/>
                <RowDefinition x:Name="RowPatches" Height="180" MinHeight="110" MaxHeight="520"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Mod library" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock x:Name="TxtLibraryCount" Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                  <Button x:Name="BtnImport" Content="Import..." ToolTip="Choose one or more PAK/ZIP/7Z/RAR files, or import all compatible mods from a folder"/>
                  <Button x:Name="BtnImportGameMods" Content="Import ~mods" ToolTip="Copy the game's current PAKs into the PMM library"/>
                  <Button x:Name="BtnScan" Content="Analyze" Padding="16,5"/>
                </WrapPanel>
              </Grid>

              <Grid Grid.Row="1" Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TxtModFilter" ToolTip="Filter source mods by name or state"/>
                <TextBlock Grid.Column="1" Text="Filter" VerticalAlignment="Center" Margin="8,0,2,0" Foreground="{DynamicResource MutedText}"/>
              </Grid>

              <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DataGrid x:Name="LstMods" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" AlternationCount="2" AllowDrop="True" HorizontalGridLinesBrush="{DynamicResource GridLine}" ToolTip="Ctrl/Shift select multiple mods; Ctrl+A selects all. Merge order: drag a row, or type a new number in Order. Top applies earlier; bottom has higher priority.">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                    <Style.Triggers>
                      <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource CardAltBackground}"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger>
                      <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value="0.58"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="On" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Enabled source mods participate in Analyze, Build and Deploy"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Order" Width="66" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Priority, Mode=OneWay}" Tag="{Binding Name}" Style="{StaticResource PriorityEditorTextBox}" ToolTip="Type a new merge position. Values below 1 become 1; values above the library size become the last position."/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="MB" Binding="{Binding SizeText}" Width="72" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Hash" Binding="{Binding HashShort}" Width="105" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>

              <StackPanel Grid.Row="1" Margin="0,7,0,0">
                <WrapPanel HorizontalAlignment="Center">
                  <Button x:Name="BtnSelectAllMods" Content="Select all" IsEnabled="False"/>
                  <Button x:Name="BtnClearModSelection" Content="Clear selection" IsEnabled="False"/>
                  <Button x:Name="BtnEnableMods" Content="Enable selected" IsEnabled="False"/>
                  <Button x:Name="BtnDisableMods" Content="Disable selected" IsEnabled="False"/>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                  <Button x:Name="BtnPriorityUp" Content="Earlier / lower priority" IsEnabled="False" ToolTip="Move this mod upward: its diff is applied earlier"/>
                  <Button x:Name="BtnPriorityDown" Content="Later / higher priority" IsEnabled="False" ToolTip="Move this mod downward: it wins truly overlapping values"/>
                  <Button x:Name="BtnDeleteMod" Content="Delete selected" IsEnabled="False"/>
                  <ComboBox x:Name="CmbLibraryOrder" Width="188" Margin="3" ToolTip="Reorder the imported mod library. Changing order invalidates Analyze."/>
                  <Button x:Name="BtnReorderLibrary" Content="Reorder" IsEnabled="True" ToolTip="Reorder the imported mod library. Changing order invalidates Analyze."/>
                </WrapPanel>
              </StackPanel>


              </Grid>

              <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

              <Border Grid.Row="4" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource CardAltBackground}" Padding="6">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="1,0,1,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Compatibility patches" FontWeight="SemiBold"/>
                      <TextBlock x:Name="TxtPatchCount" Foreground="{DynamicResource MutedText}" FontSize="11.5"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                      <Button x:Name="BtnValidatePatch" Content="Validate merge" Padding="8,3" MinHeight="26" IsEnabled="False" ToolTip="Mark the selected saved merge as tested and functional in runtime."/>
                      <Button x:Name="BtnDeletePatch" Content="Delete merge" Padding="8,3" MinHeight="26" IsEnabled="False" ToolTip="Delete the exact deployed copy if present and every matching saved copy inside PMM."/>
                    </WrapPanel>
                  </Grid>
                  <TextBlock Grid.Row="1" Margin="2,0,2,4" FontSize="10.5" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Text="Choose a saved overlay, or No compatibility patch to deploy source mods only. A deployed external PMM merge can still be inspected/undeployed/deleted even when it is not selectable for Deploy; only exact source hashes + mappings make a build reusable."/>
                  <DataGrid x:Name="LstPatches" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" FontSize="11" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="Use" Width="42">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><RadioButton GroupName="PMMPatchSelection" IsChecked="{Binding Selected, Mode=OneWay}" IsEnabled="{Binding Selectable}" Tag="{Binding SelectionKey}" ToolTip="{Binding SelectTip}" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Patch" Binding="{Binding Name}" Width="*" MinWidth="135" IsReadOnly="True"/>
                      <DataGridTextColumn Header="Decision" Binding="{Binding DecisionSummary}" Width="130" IsReadOnly="True"/>
                      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" IsReadOnly="True"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>

            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

          <!-- Analysis is the dominant workspace. Conflict and unsupported sections collapse when unused. -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="RowAnalysisWorkspace" Height="*"/>
              <RowDefinition x:Name="RowAnalysisConflictSplitter" Height="0"/>
              <RowDefinition x:Name="RowResolutionWorkspace" Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition x:Name="RowWorkspaceFiller" Height="0"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Expander x:Name="ExpAnalysis" Grid.Row="0" Header="Analysis plan" IsExpanded="True" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtAnalysisHeadline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="3,0,3,5"/>
                <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,5">
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftBlue}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtSharedCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Shared assets" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftGreen}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtAutoCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Auto merged" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftAmber}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtDecisionCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Decisions" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SoftRed}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtUnsupportedCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Unsupported" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource BuildBackground}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtExperimentalCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Experimental" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                  <Border Style="{StaticResource SummaryCard}"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtIdenticalCount" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Identical" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
                </UniformGrid>

                <TextBlock x:Name="TxtAnalysisScope" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="3,0,3,6"/>
                <StackPanel Grid.Row="3" Margin="3,0,3,5">
                  <TextBlock x:Name="TxtAnalyzeProgress" Text="" Foreground="{DynamicResource MutedText}"/>
                  <ProgressBar x:Name="PrgAnalyze" Height="10" Margin="0,3,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50"/>
                </StackPanel>

                <DataGrid x:Name="DgAnalysisAssets" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowDetailsVisibilityMode="VisibleWhenSelected" EnableRowVirtualization="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="125"/>
                    <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="1.25*"/>
                    <DataGridTextColumn Header="Adapter" Binding="{Binding Adapter}" Width="145"/>
                    <DataGridTextColumn Header="Mods involved" Binding="{Binding Providers}" Width="1.7*"/>
                    <DataGridTextColumn Header="Changes" Binding="{Binding Changes}" Width="105"/>
                  </DataGrid.Columns>
                  <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource CardAltBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,1" Padding="10,7">
                        <StackPanel>
                          <TextBlock Text="{Binding FullAsset}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Details}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </DataGrid.RowDetailsTemplate>
                </DataGrid>
              </Grid>
            </Expander>

            <GridSplitter x:Name="SplAnalysisResolution" Grid.Row="1" Height="6" Margin="0,3,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Visibility="Collapsed"/>

            <Expander x:Name="ExpConflicts" Grid.Row="2" Margin="0,6,0,0" IsExpanded="False" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="6">
              <Expander.Header><TextBlock x:Name="TxtConflictHeader" Text="Resolution &amp; Review (0)" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/></Expander.Header>
              <Grid MinHeight="175" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="ColConflictAssets" Width="250" MinWidth="175"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*" MinWidth="360"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="LstConflictAssets" Grid.Column="0" DisplayMemberPath="Display"/>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
                <Grid Grid.Column="2" Margin="8,0,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock x:Name="TxtConflictMods" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="TxtConflictAsset" Grid.Row="1" Margin="0,3,0,7" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                  <WrapPanel Grid.Row="2" Margin="0,0,0,7" VerticalAlignment="Center">
                    <TextBlock Text="Apply all:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbBulkWinner" Width="190" Margin="0,0,6,0"/>
                    <TextBlock Text="Custom:" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <TextBox x:Name="TxtBulkCustom" Width="110" Margin="0,0,6,0" ToolTip="Used only when Custom is selected"/>
                    <Button x:Name="BtnApplyBulk" Content="Apply to all rows"/>
                    <Button x:Name="BtnOpenReview" Content="Open review files"/>
                  </WrapPanel>
                  <DataGrid x:Name="DgDecisions" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="CellOrRowHeader" IsReadOnly="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
                </Grid>
              </Grid>
            </Expander>

            <Expander x:Name="ExpUnsupported" Grid.Row="3" Header="Blocked shared assets (0)" Margin="0,6,0,0" IsExpanded="False" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="6">
              <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="LstUnsupportedAssets" Grid.Row="0" MaxHeight="86" DisplayMemberPath="Display"/>
                <TextBox x:Name="TxtUnsupported" Grid.Row="1" Margin="0,5,0,5" MaxHeight="90" MinHeight="42" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardAltBackground}"/>
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Disable source:" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <ComboBox x:Name="CmbUnsupportedDisable" Grid.Column="1" Margin="0,0,7,0"/>
                  <Button x:Name="BtnDisableUnsupported" Grid.Column="2" Content="Disable selected mod &amp; Analyze" Style="{StaticResource PrimaryButton}" Padding="10,4"/>
                  <TextBlock x:Name="TxtUnsupportedHint" Grid.Column="3" Text="When an asset is unsupported, PMM can suggest the source whose removal disturbs the fewest other compatible shared merges. This is a structural suggestion, not a gameplay judgement." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Margin="10,0,0,0"/>
                </Grid>
                <WrapPanel Grid.Row="3" Margin="0,5,0,0">
                  <Button x:Name="BtnOpenAIHandoff" Content="CREATE AI HANDOFF" IsEnabled="False" ToolTip="Create/open one AIIO ZIP for all current Unsupported cases. Only exact conflicting files are extracted; whole source PAKs are never copied."/>
                  <Button x:Name="BtnImportManualSolution" Content="Import AI/manual solution..." IsEnabled="False" ToolTip="Import PMM_MANUAL_SOLUTION_V1. PMM validates structure/provenance, but it remains experimental until tested in game."/>
                </WrapPanel>
              </Grid>
            </Expander>

            <Border Grid.Row="5" Margin="0,6,0,0" Padding="8" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="2,0,2,3">
                  <TextBlock Text="Build &amp; Deploy:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <CheckBox x:Name="ChkCloseGame" Content="Close Palworld before Deploy" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  <CheckBox x:Name="ChkForceClose" Content="Force close if graceful shutdown times out" VerticalAlignment="Center" Margin="0,0,18,0"/>
                </WrapPanel>
                <TextBlock x:Name="TxtBuildDeployHint" Grid.Row="1" Margin="3,0,3,4" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                <UniformGrid Grid.Row="2" Rows="1" Columns="3">
                  <Button x:Name="BtnBuild" Content="BUILD MERGE" FontWeight="Bold"/>
                  <Button x:Name="BtnDeploy" Content="DEPLOY"/>
                  <Button x:Name="BtnUndeployPatch" Content="UNDEPLOY" IsEnabled="False" ToolTip="Remove only the selected merge from Palworld ~mods. The saved PMM build is kept."/>
                </UniformGrid>
                <StackPanel Grid.Row="3" Margin="3,5,3,0">
                  <TextBlock x:Name="TxtOperationProgress" Text="Ready. The last operation will remain here." HorizontalAlignment="Center" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="PrgOperation" Height="10" Margin="40,3,40,0" Minimum="0" Maximum="100" Value="0" Visibility="Visible" Foreground="#64748B"/>
                  <TextBlock x:Name="TxtBuildProgress" Text="" Visibility="Collapsed"/>
                  <ProgressBar x:Name="PrgBuild" Height="1" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="TabFixLab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="FIX LAB" VerticalAlignment="Center"/>
            <Border x:Name="BrdFixLabBadge" Background="#D97706" CornerRadius="9" Margin="6,0,0,0" Padding="6,1" Visibility="Collapsed">
              <TextBlock x:Name="TxtFixLabBadge" Text="1" Foreground="White" FontWeight="Bold" FontSize="11"/>
            </Border>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" CanContentScroll="True">
          <Grid Margin="10" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Compact Fix Lab header + Game Reference controls. -->
            <Border Grid.Row="0" Background="{DynamicResource FixHeaderBackground}" BorderBrush="{DynamicResource FixHeaderBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Fix Lab" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource FixHeaderBorder}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="LOCAL RECIPE ENGINE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="Repair supported legacy mods locally with the source PAK, your current game files, and compact reproducible recipes." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,2,0,0"/>
                  <TextBlock x:Name="TxtFixLabGameReference" Text="Current Game Reference" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" Margin="0,5,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="TxtFixLabGameReferenceProgress" Foreground="{DynamicResource MutedText}" Visibility="Collapsed" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PrgFixLabGameReference" Width="180" Height="7" Margin="8,0,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#2E9D50" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <Button x:Name="BtnFixLabRefreshDashboard" Content="Refresh Fix Lab" MinWidth="180" ToolTip="Refresh the Fix Lab dashboard on demand. Tab switching uses the cached view so navigation stays immediate."/>
                  <Button x:Name="BtnFixLabBuildReference" Content="Build / refresh Game Reference" MinWidth="180"/>
                  <Button x:Name="BtnFixLabOpenReference" Content="Open reference" MinWidth="180" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Notice does not consume a permanent grid slot. -->
            <Border x:Name="BrdFixLabNotice" Grid.Row="1" Background="{DynamicResource NoticeBackground}" BorderBrush="{DynamicResource NoticeBorder}" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center" Margin="1,0,8,0"/>
                <TextBlock x:Name="TxtFixLabNotice" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingAmber}"/>
                <Button x:Name="BtnFixLabDismissNotice" Grid.Column="2" Content="X" ToolTip="Dismiss" Margin="10,0,0,0" Padding="9,2"/>
              </Grid>
            </Border>

            <!-- Six responsive work cards: 2 columns x 3 rows. No minimum widths. -->
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

              <Expander x:Name="ExpFixLabSource" Grid.Row="0" Grid.Column="0" IsExpanded="True" Background="{DynamicResource SourceBackground}" BorderBrush="{DynamicResource SourceBorder}" BorderThickness="1" Padding="9" Margin="0,0,4,8">
                <Expander.Header>
                  <StackPanel Margin="0,1">
                    <TextBlock Text="1. Repairable source" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingBlue}"/>
                    <TextBlock x:Name="TxtFixLabCandidateCount" Text="0 candidates" Foreground="{DynamicResource MutedText}" FontSize="11"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,0">
                  <DockPanel LastChildFill="True">
                    <Button x:Name="BtnFixLabDiscover" DockPanel.Dock="Right" Content="Analyze fixable mods" Margin="8,0,0,5" Padding="10,4"/>
                    <Button x:Name="BtnFixLabIgnoreSource" DockPanel.Dock="Right" Content="Ignore this legacy mod" Margin="8,0,0,5" Padding="10,4" ToolTip="Skip Fix Lab for this exact source hash and allow Analyze/AUTO to continue under your responsibility."/>
                    <Button x:Name="BtnFixLabDeleteSource" DockPanel.Dock="Right" Content="Delete this mod" Margin="8,0,0,5" Padding="10,4" ToolTip="Delete the source mod from the PMM library and its exact matching PAK from ~mods using the same operation as Imported Mods > Delete."/>
                    <TextBlock Text="Choose the legacy mod case that Fix Lab should repair." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,3,0,5"/>
                  </DockPanel>
                  <ListBox x:Name="LstFixLabCandidates" SelectionMode="Single" SelectedValuePath="RecipeId" MinHeight="70" MaxHeight="130">
                    <ListBox.ItemTemplate><DataTemplate>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <RadioButton VerticalAlignment="Center" IsHitTestVisible="False" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceNames}" FontSize="11" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SourceCount}" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Margin="6,0,2,0"/>
                      </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="TxtFixLabCandidate" Margin="0,5,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Text="Only imported mods with a documented Fix Lab recipe are shown." MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Expander>

              <Expander x:Name="ExpFixLabConfigure" Grid.Row="0" Grid.Column="1" IsExpanded="True" Background="{DynamicResource ConfigureBackground}" BorderBrush="{DynamicResource ConfigureBorder}" BorderThickness="1" Padding="9" Margin="4,0,0,8">
                <Expander.Header><StackPanel Margin="0,1"><TextBlock Text="2. Configure repair" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingAmber}"/><TextBlock Text="Choose the output you want. PMM never selects a cosmetic or behavior variant for you." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,6,0,0">
                  <TextBlock Text="Output variant" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <ComboBox x:Name="CmbFixLabVariant" DisplayMemberPath="Label" SelectedValuePath="Id" HorizontalAlignment="Stretch"/>
                  <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ConfigureBorder}" BorderThickness="1" CornerRadius="5" Padding="8"><StackPanel><TextBlock Text="Recipe summary" FontWeight="SemiBold" Margin="0,0,0,3"/><TextBlock TextWrapping="Wrap"><Run Text="Legacy source: "/><Run x:Name="TxtFixLabLegacySource" Text="-"/></TextBlock><TextBlock TextWrapping="Wrap"><Run Text="Fix modules: "/><Run x:Name="TxtFixLabModules" Text="-"/></TextBlock><TextBlock TextWrapping="Wrap"><Run Text="Output size: "/><Run x:Name="TxtFixLabOutputSize" Text="Pending build"/></TextBlock></StackPanel></Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ConfigureBorder}" BorderThickness="1" CornerRadius="5" Padding="8"><StackPanel><TextBlock Text="Repair notes" FontWeight="SemiBold" Margin="0,0,0,3"/><TextBlock x:Name="TxtFixLabVariantDescription" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" MaxHeight="72"/></StackPanel></Border>
                  </Grid>
                </StackPanel>
              </Expander>

              <Expander x:Name="ExpFixLabBuild" Grid.Row="1" Grid.Column="0" IsExpanded="True" Background="{DynamicResource BuildBackground}" BorderBrush="{DynamicResource BuildBorder}" BorderThickness="1" Padding="9" Margin="0,0,4,8">
                <Expander.Header><StackPanel Margin="0,1"><TextBlock Text="3. Build and validate" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingPurple}"/><TextBlock Text="Runs in a separate processing process. You can keep using PMM while the repair is built and validated." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander.Header>
                <Grid Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel><TextBlock x:Name="TxtFixLabRepairState" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/><TextBlock x:Name="TxtFixLabResult" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" MaxHeight="58"/>
                    <TextBlock x:Name="TxtFixLabRepairProgress" Margin="0,7,0,2" TextWrapping="Wrap" Foreground="{DynamicResource AccentHeadingPurple}" Visibility="Collapsed"/>
                    <ProgressBar x:Name="PrgFixLabRepair" Height="9" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#6D5AA8"/></StackPanel>
                  <Grid Grid.Row="1" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Builds the selected output in the Fix Lab Workshop. Nothing is installed until Apply Fix succeeds." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,0,8,0"/><Button x:Name="BtnFixLabRepair" Grid.Column="1" Content="Repair" MinWidth="130" Padding="16,6" VerticalAlignment="Center"/></Grid>
                </Grid>
              </Expander>

              <Expander x:Name="ExpFixLabOutputs" Grid.Row="1" Grid.Column="1" IsExpanded="True" Background="{DynamicResource OutputBackground}" BorderBrush="{DynamicResource OutputBorder}" BorderThickness="1" Padding="9" Margin="4,0,0,8">
                <Expander.Header><StackPanel Margin="0,1"><TextBlock Text="4. Built outputs" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHeadingGreen}"/><TextBlock x:Name="TxtFixLabBuiltCount" Text="0 variants" Foreground="{DynamicResource MutedText}" FontSize="11"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,6,0,0">
                  <TextBlock Text="Validated outputs remain stored so you can switch variants without repairing again." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,0,0,4"/>
                  <ListBox x:Name="LstFixLabBuiltFixes" SelectionMode="Single" SelectedValuePath="BuildId" MinHeight="72" MaxHeight="130"><ListBox.ItemTemplate><DataTemplate>
